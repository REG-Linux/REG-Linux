Subject: Ignore ELAN HID battery reports (8bitdo battery quirks)
Origin: Batocera, first committed by Nicolas Adenis-Lamarre on 2021-04-22 ("8bitdo battery quirks"),
        board/batocera/broadcom/linux_patches/linux-battery-quircks.patch
Note: original patch carries no From:/Signed-off-by: header; author taken from the Batocera git history.

diff --git a/drivers/hid/hid-input.c b/drivers/hid/hid-input.c
index 527fdd0..9c7df07 100644
--- a/drivers/hid/hid-input.c
+++ b/drivers/hid/hid-input.c
@@ -391,6 +391,8 @@ static const struct hid_device_id hid_battery_quirks[] = {
 	 */
 	{ HID_I2C_DEVICE(USB_VENDOR_ID_ELAN, HID_ANY_ID), HID_BATTERY_QUIRK_IGNORE },
 	{ HID_USB_DEVICE(USB_VENDOR_ID_ELAN, HID_ANY_ID), HID_BATTERY_QUIRK_IGNORE },
+	{ HID_BLUETOOTH_DEVICE(USB_VENDOR_ID_MICROSOFT, USB_DEVICE_ID_8BITDO_SN30_PRO_PLUS),
+	  HID_BATTERY_QUIRK_IGNORE },
 	{}
 };
