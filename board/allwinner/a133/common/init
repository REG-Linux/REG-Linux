#!/bin/sh
# REGLinux init for Allwinner A133 devices
#
# Injected into KNULLI's ramdisk at build time via patch-boot-img.sh.
# Uses KNULLI's busybox and tools from the ramdisk.
# Mounts /dev/mmcblk0p4 directly (FAT boot-resource partition).

# Diagnostic helper — appends a marker line to /boot_root/DIAG_LOG.
# After flashing, pull the SD card and check DIAG_LOG to see how far
# the boot progressed before the watchdog triggered a reboot.
diag() {
    mount -o remount,rw /boot_root 2>/dev/null
    echo "$1" >> /boot_root/DIAG_LOG
    sync
}

# update the rescue if needed
do_update_rescue() {
    if test -e /boot_root/boot/rescue.update
    then
        mount -o remount,rw /boot_root || return 1
        mv /boot_root/boot/rescue.update /boot_root/boot/rescue || return 1
        if test -e /boot_root/boot/overlay
        then
            mv /boot_root/boot/overlay /boot_root/boot/overlay.old || return 1
        fi
        touch /boot_root/REG_UPDATE
        mount -o remount,ro /boot_root || return 1
    fi
}

# update the modules if needed
do_update_modules() {
    if test -e /boot_root/boot/modules.update
    then
        mount -o remount,rw /boot_root || return 1
        mv /boot_root/boot/modules.update /boot_root/boot/modules || return 1
        if test -e /boot_root/boot/overlay
        then
            mv /boot_root/boot/overlay /boot_root/boot/overlay.old || return 1
        fi
        touch /boot_root/REG_UPDATE
        mount -o remount,ro /boot_root || return 1
    fi
}

# update the firmware if needed
do_update_firmware() {
    if test -e /boot_root/boot/firmware.update
    then
        mount -o remount,rw /boot_root || return 1
        mv /boot_root/boot/firmware.update /boot_root/boot/firmware || return 1
        if test -e /boot_root/boot/overlay
        then
            mv /boot_root/boot/overlay /boot_root/boot/overlay.old || return 1
        fi
        touch /boot_root/REG_UPDATE
        mount -o remount,ro /boot_root || return 1
    fi
}

# update the rootfs if needed
do_update_rootfs() {
    if test -e /boot_root/boot/reglinux.update
    then
        mount -o remount,rw /boot_root || return 1
        mv /boot_root/boot/reglinux.update /boot_root/boot/reglinux || return 1
        if test -e /boot_root/boot/overlay
        then
            mv /boot_root/boot/overlay /boot_root/boot/overlay.old || return 1
        fi
        touch /boot_root/REG_UPDATE
        mount -o remount,ro /boot_root || return 1
    fi
}

do_root() {
    mount -t devtmpfs none /dev
    mkdir -p /dev/pts
    mount -t devpts none /dev/pts
    mount -t sysfs sysfs /sys

    exec < /dev/console > /dev/console 2>&1

    echo "[$0]: Starting Watchdog"
    watchdog -t 5 /dev/watchdog0

    mkdir -p /boot_root /new_root /overlay_root /sys /proc

    sleep 1

    mount -t proc -o nodev,noexec,nosuid proc /proc

    echo "[$0]: Mounting boot partition"

    # A133 GPT layout: p4 = boot-resource (FAT, REGLINUX label)
    # Mount directly like KNULLI — no LABEL= lookup needed
    while ! mount /dev/mmcblk0p4 /boot_root
    do
        echo "Waiting for /dev/mmcblk0p4"
        sleep 1
    done

    diag "01_BOOT_MOUNTED dev=mmcblk0p4"

    # Process updates if any
    do_update_modules
    do_update_firmware
    do_update_rootfs
    do_update_rescue

    diag "02_UPDATES_DONE"

    # create an overlay on memory
    mount -t tmpfs -o size=256M tmpfs /overlay_root || return 1
    mkdir /overlay_root/base /overlay_root/overlay /overlay_root/work /overlay_root/saved || return 1

    if test -f /boot_root/REG_UPDATE || test -f /boot_root/REG_RESCUE
    then
        diag "03_MOUNTING rescue (REG_UPDATE/REG_RESCUE present)"
        if ! mount /boot_root/boot/rescue /overlay_root/base; then
            diag "03_RESCUE_MOUNT_FAILED"
            return 1
        fi
    else
        # fill the overlay with the stored one
        if test -f /boot_root/boot/overlay
        then
            if mount -o ro /boot_root/boot/overlay /overlay_root/saved
            then
                cp -pr /overlay_root/saved/* /overlay_root/overlay || return 1
                umount /overlay_root/saved                         || return 1
            fi
        fi

        diag "03_MOUNTING reglinux (normal boot)"
        if ! mount /boot_root/boot/reglinux /overlay_root/base; then
            diag "03_REGLINUX_MOUNT_FAILED"
            return 1
        fi
    fi

    diag "04_SQUASHFS_OK"

    # mount the future root in read write
    if ! mount -t overlay overlay -o rw,lowerdir=/overlay_root/base,upperdir=/overlay_root/overlay,workdir=/overlay_root/work /new_root
    then
        diag "05_OVERLAY_FAILED fallback_to_direct_mount"
        if test -f /boot_root/REG_UPDATE || test -f /boot_root/REG_RESCUE
        then
            mount /boot_root/boot/rescue /new_root || return 1
        else
            mount /boot_root/boot/reglinux /new_root || return 1
        fi
    fi

    diag "05_ROOT_MOUNTED"

    # firmware mount — non-fatal (allow boot to continue for diagnostics)
    mkdir -p /new_root/lib/firmware
    if ! mount /boot_root/boot/firmware /new_root/lib/firmware; then
        diag "06_FIRMWARE_MOUNT_FAILED (continuing)"
    fi

    # modules mount — non-fatal
    mkdir -p /new_root/lib/modules
    mount /boot_root/boot/modules /new_root/lib/modules 2>/dev/null || true

    diag "06_MOUNTS_DONE"
    diag "07_PRE_SWITCH sbin_init=$(ls -la /new_root/sbin/init 2>&1) lib_modules=$(ls /new_root/lib/modules/ 2>&1)"

    # moving current mounts
    mkdir -p /new_root/boot /new_root/overlay /new_root/sys /new_root/proc /new_root/dev
    mount --move /boot_root    /new_root/boot    || return 1
    mount --move /overlay_root /new_root/overlay || return 1
    mount --move /sys          /new_root/sys     || return 1
    mount --move /proc         /new_root/proc    || return 1
    mount --move /dev          /new_root/dev     || return 1

    # switch to the new root
    exec switch_root /new_root /sbin/init || return 1
}

if ! do_root
then
    echo "Cannot boot to mounted filesystem !"
    /bin/sh
fi
