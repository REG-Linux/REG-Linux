# CHA-specific kernel config overrides
# CONFIG_NETCONSOLE is not set

# USB gadget stack unused on CHA (MUSB-sunxi suspend/resume is broken, MTP
# sessions drop; the Type-A port is host-only for pen drives).
# CONFIG_USB_GADGET is not set
# CONFIG_USB_MUSB_DUAL_ROLE is not set
# CONFIG_USB_MUSB_GADGET is not set
CONFIG_USB_MUSB_HOST=y

# Allwinner H3 has no integrated Bluetooth and CHA has no external BT module
# (no HCI device, no BT firmware in kernel-firmware.txt). Disable the whole
# Bluetooth stack; Kconfig cascades this to all BT_* symbols.
# CONFIG_BT is not set

# CHA has no SATA/AHCI. The shared sunxi32 config enables ATA + AHCI_SUNXI;
# disable the whole libata stack here — Kconfig cascades to SATA_HOST,
# ATA_SFF, AHCI_SUNXI, SATA_PMP, ATA_FORCE, ATA_VERBOSE_ERROR.
# CONFIG_ATA is not set
