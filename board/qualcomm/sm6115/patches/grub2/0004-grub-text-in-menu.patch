Origin: ROCKNIX projects/ROCKNIX/packages/tools/grub/patches/grub-menu-text.patch

--- a/grub-core/normal/menu_text.c	2026-03-22 14:00:59.662849891 +0000
+++ b/grub-core/normal/menu_text.c	2026-03-22 14:00:59.718852270 +0000
@@ -167,10 +167,7 @@
     {
       char *msg_translated;
 
-      msg_translated = grub_xasprintf (_("Use the %C and %C keys to select which "
-					 "entry is highlighted."),
-				       GRUB_UNICODE_UPARROW,
-				       GRUB_UNICODE_DOWNARROW);
+      msg_translated = grub_xasprintf (_("Use Volume-Up and Volume-Down to select an entry."));
       if (!msg_translated)
 	return 0;
       ret += grub_print_message_indented_real (msg_translated, STANDARD_MARGIN,
@@ -181,17 +178,17 @@
       if (nested)
 	{
 	  ret += grub_print_message_indented_real
-	    (_("Press enter to boot the selected OS, "
-	       "`e' to edit the commands before booting "
-	       "or `c' for a command-line. ESC to return previous menu."),
+	    (_("Press the Power button to boot the selected device. "
+	       "The selected device will be set as the default "
+	       "and automatically selected on subsequent boots."),
 	     STANDARD_MARGIN, STANDARD_MARGIN, term, dry_run);
 	}
       else
 	{
 	  ret += grub_print_message_indented_real
-	    (_("Press enter to boot the selected OS, "
-	       "`e' to edit the commands before booting "
-	       "or `c' for a command-line."),
+	    (_("Press the Power button to boot the selected device. "
+	       "The selected device will be set as the default "
+	       "and automatically selected on subsequent boots."),
 	     STANDARD_MARGIN, STANDARD_MARGIN, term, dry_run);
 	}
     }
