+/* I2C5 - Touchscreen (Synaptics RMI4) */
+&i2c5 {
+	status = "okay";
+	clock-frequency = <400000>;
+
+	touchscreen@70 {
+		compatible = "syna,rmi4-i2c";
+		reg = <0x70>;
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		interrupt-parent = <&tlmm>;
+		interrupts = <125 IRQ_TYPE_EDGE_FALLING>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&ts_int_active &ts_reset_active>;
+
+		vdd-supply = <&vreg_l28a_3p0>;
+		vio-supply = <&vreg_l14a_1p88>;
+
+		reset-gpios = <&tlmm 104 GPIO_ACTIVE_LOW>;
+
+		syna,reset-delay-ms = <200>;
+		syna,startup-delay-ms = <200>;
+
+		rmi4-f01@1 {
+			reg = <0x01>;
+			syna,nosleep-mode = <1>;
+		};
+
+		rmi4-f12@12 {
+			reg = <0x12>;
+			syna,sensor-type = <1>;
+			touchscreen-x-mm = <135>;
+			touchscreen-y-mm = <76>;
+		};
+	};
+};
+
+/* I2C4 - HDMI Bridge (Lontium LT8912B) */
+&i2c4 {
+	status = "okay";
+	clock-frequency = <100000>;
+
+	hdmi_bridge: hdmi-bridge@48 {
+		compatible = "lontium,lt8912b";
+		reg = <0x48>;
+		#sound-dai-cells = <0>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&lt8912_pins>;
+
+		reset-gpios = <&tlmm 12 GPIO_ACTIVE_HIGH>;
+		power-gpios = <&tlmm 8 GPIO_ACTIVE_HIGH>;
+		enable-gpios = <&tlmm 13 GPIO_ACTIVE_HIGH>;
+		hpd-gpios = <&tlmm 121 GPIO_ACTIVE_HIGH>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				lt8912_in: endpoint {
+					remote-endpoint = <&mdss_dsi1_out>;
+				};
+			};
+
+			port@1 {
+				reg = <1>;
+				lt8912_out: endpoint {
+					remote-endpoint = <&hdmi_con_in>;
+				};
+			};
+		};
+	};
+
+	/* Micro HDMI Bridge on same I2C bus, different address */
+	micro_hdmi_bridge: hdmi-bridge@49 {
+		compatible = "lontium,lt8912b";
+		reg = <0x49>;
+		#sound-dai-cells = <0>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&lt8912_micro_pins>;
+
+		reset-gpios = <&tlmm 94 GPIO_ACTIVE_LOW>;
+		power-gpios = <&tlmm 93 GPIO_ACTIVE_HIGH>;
+		enable-gpios = <&tlmm 97 GPIO_ACTIVE_HIGH>;
+		hpd-gpios = <&tlmm 98 GPIO_ACTIVE_HIGH>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				lt8912_micro_in: endpoint {
+					remote-endpoint = <&mdss_dp_out>;
+				};
+			};
+
+			port@1 {
+				reg = <1>;
+				lt8912_micro_out: endpoint {
+					remote-endpoint = <&micro_hdmi_con_in>;
+				};
+			};
+		};
+	};
+};
+
+/* Display subsystem */
+&mdss {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	status = "okay";
+	vdda-supply = <&vreg_l26a_1p2>;
+
+	panel@0 {
+		compatible = "innolux,td4328";
+		reg = <0>;
+
+		backlight = <&pmi8998_wled>;
+
+		vddio-supply = <&vreg_l14a_1p88>;
+		vsp-supply = <&lab>;
+		vsn-supply = <&ibb>;
+
+		reset-gpios = <&tlmm 6 GPIO_ACTIVE_HIGH>;
+		enable-gpios = <&tlmm 120 GPIO_ACTIVE_HIGH>;
+		rotation = <90>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&panel_reset_pins &panel_enable_pins>;
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	remote-endpoint = <&panel_in>;
+	data-lanes = <0 1 2 3>;
+};
+
+&mdss_dsi0_phy {
+	status = "okay";
+	vdds-supply = <&vreg_l1a_0p875>;
+};
+
+/* DSI1 for external HDMI output via LT8912B bridge */
+&mdss_dsi1 {
+	status = "okay";
+	vdda-supply = <&vreg_l26a_1p2>;
+};
+
+&mdss_dsi1_out {
+	remote-endpoint = <&lt8912_in>;
+	data-lanes = <0 1 2 3>;
+};
+
+&mdss_dsi1_phy {
+	status = "okay";
+	vdds-supply = <&vreg_l1a_0p875>;
+};
+
+/* DisplayPort for micro HDMI output */
+&mdss_dp {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&dp_hpd_pins>;
+
+	data-lanes = <0 1 2 3>;
+};
+
+&mdss_dp_out {
+	remote-endpoint = <&lt8912_micro_in>;
+	data-lanes = <0 1 2 3>;
+};
+
+&mss_pil {
+	status = "okay";
+	firmware-name = "qcom/sdm845/mba.mbn", "qcom/sdm845/modem_nm.mbn";
+};
+
+&pmi8998_charger {
+	monitored-battery = <&battery>;
+	status = "okay";
+};
+
+&pmi8998_fg {
+	monitored-battery = <&battery>;
+	power-supplies = <&pmi8998_charger>;
+	status = "okay";
+};
+
+&pmi8998_lpg {
+    status = "okay";
+
+    /* Haptics / Vibrator Configuration */
+    qcom,vmax-mv = <3596>;
+    qcom,wave-play-rate-us = <6667>;
+    qcom,actuator-type = <1>; /* LRA */
+    qcom,wave-shape = "square";
+    qcom,brake-pattern = <0x3 0x3 0x2 0x1>;
+
+    /* RGB Notification LED */
+    multi-led {
+        color = <LED_COLOR_ID_RGB>;
+        function = LED_FUNCTION_STATUS;
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        led@3 {
+            reg = <3>;
+            color = <LED_COLOR_ID_BLUE>;
+        };
+
+        led@4 {
+            reg = <4>;
+            color = <LED_COLOR_ID_GREEN>;
+        };
+
+        led@5 {
+            reg = <5>;
+            color = <LED_COLOR_ID_RED>;
+        };
+    };
+};
+
+&pmi8998_rradc {
+	status = "okay";
+};
+
+&pmi8998_wled {
+	status = "okay";
+	qcom,enabled-strings = <0 1>;
+	qcom,num-strings = <2>;
+	qcom,switching-freq = <800>;
+	qcom,ovp-millivolt = <29600>;
+	qcom,current-boost-limit = <970>;
+	qcom,current-limit-microamp = <20000>;
+	qcom,fs-current-microamp = <22500>;
+};
+
+/* LAB/IBB regulators for display */
+&lab {
+	regulator-min-microvolt = <5500000>;
+	regulator-max-microvolt = <5500000>;
+	status = "okay";
+};
+
+&ibb {
+	regulator-min-microvolt = <5500000>;
+	regulator-max-microvolt = <5500000>;
+	status = "okay";
+};
+
+/* Sound - WCD9340 codec with WSA881x speakers */
+&q6afedai {
+	dai@16 {
+		reg = <SLIMBUS_0_RX>;
+		qcom,sd-lines = <0>;
+	};
+
+	dai@17 {
+		reg = <SLIMBUS_0_TX>;
+		qcom,sd-lines = <0>;
+	};
+
+	dai@22 {
+		reg = <QUATERNARY_MI2S_RX>;
+		qcom,sd-lines = <0>;
+	};
+
+	dai@23 {
+		reg = <QUATERNARY_MI2S_TX>;
+		qcom,sd-lines = <1>;
+	};
+
+	dai@20 {
+		reg = <TERTIARY_MI2S_RX>;
+		qcom,sd-lines = <0>;
+	};
+
+	dai@18 {
+		reg = <PRIMARY_MI2S_RX>;
+		qcom,sd-lines = <0>;
+	};
+};
+
+&q6asmdai {
+	dai@0 {
+		reg = <0>;
+	};
+
+	dai@1 {
+		reg = <1>;
+	};
+
+	dai@2 {
+		reg = <2>;
+	};
+};
+
+&slim {
+    status = "okay";
+
+    wcd9340: codec@1 {
+        compatible = "slimbus,wcd9340", "slim217,250";
+        reg = <1 0>;
+        
+        pinctrl-0 = <&wcd_intr_default>;
+        pinctrl-names = "default";
+        
+        clock-names = "extclk";
+        clocks = <&rpmhcc RPMH_LN_BB_CLK2>;
+        
+        reset-gpios = <&tlmm 64 GPIO_ACTIVE_HIGH>;
+        interrupt-parent = <&tlmm>;
+        interrupts = <54 IRQ_TYPE_LEVEL_HIGH>;
+        interrupt-controller;
+        #interrupt-cells = <1>;
+        
+        vdd-buck-supply = <&vreg_s4a_1p8>;
+        vdd-buck-sido-supply = <&vreg_s4a_1p8>;
+        vdd-tx-supply = <&vreg_s4a_1p8>;
+        vdd-rx-supply = <&vreg_s4a_1p8>;
+        vdd-io-supply = <&vreg_s4a_1p8>;
+        
+        #sound-dai-cells = <1>;
+
+        /* Soundwire Master Sub-node */
+        swm: soundwire@c85 {
+            #address-cells = <2>;
+            #size-cells = <0>;
+            #sound-dai-cells = <1>;
+
+            left_spkr: speaker@0,1 {
+                compatible = "sdw20217010d00";
+                reg = <0 1>;
+                powerdown-gpios = <&tlmm 89 GPIO_ACTIVE_HIGH>;
+                #thermal-sensor-cells = <0>;
+                sound-name-prefix = "SpkrLeft";
+                #sound-dai-cells = <0>;
+                vdd-supply = <&vreg_s4a_1p8>;
+                vdd-io-supply = <&vreg_s4a_1p8>;
+            };
+
+            right_spkr: speaker@0,2 {
+                compatible = "sdw20217010d00";
+                reg = <0 2>;
+                powerdown-gpios = <&tlmm 90 GPIO_ACTIVE_HIGH>;
+                #thermal-sensor-cells = <0>;
+                sound-name-prefix = "SpkrRight";
+                #sound-dai-cells = <0>;
+                vdd-supply = <&vreg_s4a_1p8>;
+                vdd-io-supply = <&vreg_s4a_1p8>;
+            };
+        };
+    };
+};
+
+/* Sound card configuration */
+/ {
+	sound: sound {
+		compatible = "ayn,odin-sndcard", "qcom,sdm845-sndcard";
+		model = "ayn-odin";
+		pinctrl-0 = <&quat_mi2s_active &quat_mi2s_sd0_active &quat_mi2s_sd1_active
+			     &tert_mi2s_active &tert_mi2s_sd0_active
+			     &pri_mi2s_active &pri_mi2s_sd0_active>;
+		pinctrl-names = "default";
+		
+		audio-routing = 
+			"RX_BIAS", "MCLK",
+			"AMIC2", "MIC BIAS2",
+			"SpkrLeft IN", "SPK1 OUT",
+			"SpkrRight IN", "SPK2 OUT",
+			"HDMI Playback", "Tertiary MI2S Playback",
+			"Micro HDMI Playback", "Primary MI2S Playback";
+
+		mm1-dai-link {
+			link-name = "MultiMedia1";
+			cpu {
+				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>;
+			};
+		};
+
+		mm2-dai-link {
+			link-name = "MultiMedia2";
+			cpu {
+				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA2>;
+			};
+		};
+
+		mm3-dai-link {
+			link-name = "MultiMedia3";
+			cpu {
+				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA3>;
+			};
+		};
+
+		/* SLIMbus backend for WCD9340 codec */
+		slim-dai-link {
+			link-name = "SLIM Playback";
+			cpu {
+				sound-dai = <&q6afedai SLIMBUS_0_RX>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+
+			codec {
+				sound-dai =  <&left_spkr>, <&right_spkr>, <&swm 0>, <&wcd9340 0>;
+			};
+		};
+
+		/* SLIMbus capture */
+		slim-capture-dai-link {
+			link-name = "SLIM Capture";
+			cpu {
+				sound-dai = <&q6afedai SLIMBUS_0_TX>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+
+			codec {
+				sound-dai = <&wcd9340 1>;
+			};
+		};
+
+		/* Quaternary MI2S for WSA881x speakers */
+		quat-mi2s-dai-link {
+			link-name = "Quaternary MI2S";
+			cpu {
+				sound-dai = <&q6afedai QUATERNARY_MI2S_RX>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+
+			codec {
+				sound-dai = <&left_spkr>, <&right_spkr>;
+			};
+		};
+
+		/* HDMI audio output via Tertiary MI2S to LT8912B bridge */
+		hdmi-dai-link {
+			link-name = "HDMI";
+			cpu {
+				sound-dai = <&q6afedai TERTIARY_MI2S_RX>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+
+			codec {
+				sound-dai = <&hdmi_bridge>;
+			};
+		};
+
+		/* Micro HDMI audio output via Primary MI2S */
+		micro-hdmi-dai-link {
+			link-name = "Micro HDMI";
+			cpu {
+				sound-dai = <&q6afedai PRIMARY_MI2S_RX>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+
+			codec {
+				sound-dai = <&micro_hdmi_bridge>;
+			};
+		};
+	};
+};
+
+&qupv3_id_0 {
+	status = "okay";
+};
+
+&qupv3_id_1 {
+	status = "okay";
+};
+
+/* Debug UART */
+&uart9 {
+	status = "okay";
+};
+
+/* Bluetooth UART */
+&uart6 {
+	status = "okay";
+
+	bluetooth {
+		compatible = "qcom,wcn3990-bt";
+
+		power-domains = <&wcn3990_pwrseq>;
+
+		max-speed = <3200000>;
+	};
