+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
+#include <dt-bindings/input/linux-event-codes.h>
+#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/sound/qcom,q6afe.h>
+#include <dt-bindings/sound/qcom,q6asm.h>
+#include "sdm845.dtsi"
+#include "pm8998.dtsi"
+#include "pmi8998.dtsi"
+
+/ {
+	model = "AYN Odin";
+	compatible = "ayn,odin", "qcom,sdm845";
+	chassis-type = "handset";
+
+	aliases {
+		serial0 = &uart9;
+		serial1 = &uart6;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	/* 6600mAh Battery */
+	battery: battery {
+		compatible = "simple-battery";
+		voltage-min-design-microvolt = <3400000>;
+		voltage-max-design-microvolt = <4400000>;
+		energy-full-design-microwatt-hours = <24420000>;
+		charge-full-design-microamp-hours = <6600000>;
+	};
+
+	/* External 5V boost for USB OTG */
+	vreg_5p0_boost: vreg-5p0-boost {
+		compatible = "regulator-fixed";
+		regulator-name = "vreg_5p0_boost";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		
+		gpio = <&tlmm 129 GPIO_ACTIVE_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&usb_boost_en>;
+	};
+
+	/* 3.3V regulator for USB */
+	vreg_3p3_usb: vreg-3p3-usb {
+		compatible = "regulator-fixed";
+		regulator-name = "vreg_3p3_usb";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-always-on;
+		
+		gpio = <&tlmm 128 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		pinctrl-names = "default";
+		pinctrl-0 = <&usb_3v3_en>;
+	};
+
+	/* 1.2V regulator for USB */
+	vreg_1p2_usb: vreg-1p2-usb {
+		compatible = "regulator-fixed";
+		regulator-name = "vreg_1p2_usb";
+		regulator-min-microvolt = <1200000>;
+		regulator-max-microvolt = <1200000>;
+		regulator-always-on;
+		
+		gpio = <&tlmm 135 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		pinctrl-names = "default";
+		pinctrl-0 = <&usb_1v2_en>;
+	};
+
+	/* GPIO Keys */
+	gpio-keys {
+		compatible = "gpio-keys";
+		label = "gpio-keys";
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&vol_up_n>;
+
+		key-volume-up {
+			label = "Volume Up";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&pm8998_gpios 6 GPIO_ACTIVE_LOW>;
+			debounce-interval = <15>;
+			wakeup-source;
+		};
+	};
+
+	/* Gamepad GPIO inputs */
+	gpio-gamepad {
+		compatible = "gpio-keys-polled";
+		poll-interval = <10>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&gamepad_pins>;
+
+		/* D-pad and face buttons */
+		button-a {
+			label = "A Button";
+			linux,code = <BTN_SOUTH>;
+			gpios = <&tlmm 91 GPIO_ACTIVE_LOW>;
+		};
+
+		button-b {
+			label = "B Button";
+			linux,code = <BTN_EAST>;
+			gpios = <&tlmm 92 GPIO_ACTIVE_LOW>;
+		};
+
+		button-x {
+			label = "X Button";
+			linux,code = <BTN_WEST>;
+			gpios = <&tlmm 95 GPIO_ACTIVE_LOW>;
+		};
+
+		button-y {
+			label = "Y Button";
+			linux,code = <BTN_NORTH>;
+			gpios = <&tlmm 96 GPIO_ACTIVE_LOW>;
+		};
+
+		button-l1 {
+			label = "L1";
+			linux,code = <BTN_TL>;
+			gpios = <&tlmm 40 GPIO_ACTIVE_LOW>;
+		};
+
+		button-r1 {
+			label = "R1";
+			linux,code = <BTN_TR>;
+			gpios = <&tlmm 41 GPIO_ACTIVE_LOW>;
+		};
+
+		button-select {
+			label = "Select";
+			linux,code = <BTN_SELECT>;
+			gpios = <&tlmm 122 GPIO_ACTIVE_LOW>;
+		};
+
+		button-start {
+			label = "Start";
+			linux,code = <BTN_START>;
+			gpios = <&tlmm 124 GPIO_ACTIVE_LOW>;
+		};
+
+		button-dpad-up {
+			label = "D-Pad Up";
+			linux,code = <BTN_DPAD_UP>;
+			gpios = <&tlmm 0 GPIO_ACTIVE_LOW>;
+		};
+
+		button-dpad-down {
+			label = "D-Pad Down";
+			linux,code = <BTN_DPAD_DOWN>;
+			gpios = <&tlmm 3 GPIO_ACTIVE_LOW>;
+		};
+
+		button-dpad-left {
+			label = "D-Pad Left";
+			linux,code = <BTN_DPAD_LEFT>;
+			gpios = <&tlmm 7 GPIO_ACTIVE_LOW>;
+		};
+
+		button-dpad-right {
+			label = "D-Pad Right";
+			linux,code = <BTN_DPAD_RIGHT>;
+			gpios = <&tlmm 22 GPIO_ACTIVE_LOW>;
+		};
+
+		button-l3 {
+			label = "L3";
+			linux,code = <BTN_THUMBL>;
+			gpios = <&tlmm 24 GPIO_ACTIVE_LOW>;
+		};
+
+		button-r3 {
+			label = "R3";
+			linux,code = <BTN_THUMBR>;
+			gpios = <&tlmm 25 GPIO_ACTIVE_LOW>;
+		};
+
+		button-menu {
+			label = "Menu";
+			linux,code = <BTN_MODE>;
+			gpios = <&tlmm 26 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	/* Fan cooling with PWM control */
+	fan: pwm-fan {
+		compatible = "pwm-fan";
+		pwms = <&pmi8998_lpg 1 50000>; /* Channel 2, 20kHz */
+		cooling-min-state = <0>;
+		cooling-max-state = <255>;
+		#cooling-cells = <2>;
+		
+		/* Fan control GPIOs */
+		fan-supply = <&vreg_3p3_usb>;
+		
+		pinctrl-names = "default";
+		pinctrl-0 = <&fan_pins>;
+	};
+
+	/* WCN3990 WiFi/BT Power Sequencer */
+	wcn3990_pwrseq: wcn3990-pwrseq {
+		compatible = "qcom,wcn3990-pwrseq";
+		
+		vddio-supply = <&vreg_s3a_1p35>;
+		vddxo-supply = <&vreg_s5a_2p04>;
+		vddrf-supply = <&vreg_l17a_1p3>;
+		vddch0-supply = <&vreg_l25a_3p3>;
+		
+		clocks = <&rpmhcc RPMH_RF_CLK2>;
+		clock-names = "rf_clk";
+		
+		wlan-enable-gpios = <&tlmm 52 GPIO_ACTIVE_HIGH>;
+		bt-enable-gpios = <&tlmm 83 GPIO_ACTIVE_HIGH>;
+		
+		pinctrl-names = "default";
+		pinctrl-0 = <&wcn3990_wlan_en &wcn3990_bt_en>;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		ramoops@b0000000 {
+			compatible = "ramoops";
+			reg = <0 0xb0000000 0 0x400000>;
+			record-size = <0x40000>;
+			console-size = <0x40000>;
+			ftrace-size = <0x40000>;
+			pmsg-size = <0x200000>;
+		};
+	};
+
+	vph_pwr: vph-pwr-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vph_pwr";
+		regulator-min-microvolt = <3700000>;
+		regulator-max-microvolt = <3700000>;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	hdmi-connector {
+		compatible = "hdmi-connector";
+		type = "c";  /* Type C - because it's through USB-C port */
+		label = "USB-C HDMI";
+
+		port {
+			hdmi_con_in: endpoint {
+				remote-endpoint = <&lt8912_out>;
+			};
+		};
+	};
+
+	micro-hdmi-connector {
+		compatible = "hdmi-connector";
+		type = "d";  /* Micro HDMI */
+		label = "Micro HDMI";
+
+		port {
+			micro_hdmi_con_in: endpoint {
+				remote-endpoint = <&lt8912_micro_out>;
+			};
+		};
+	};
+
+	/* Thermal zones with fan cooling */
+	thermal-zones {
+		cpu0-thermal {
+			polling-delay-passive = <250>;
+			polling-delay = <1000>;
+
+			thermal-sensors = <&tsens0 1>;
+
+			trips {
+				cpu0_alert0: trip-point0 {
+					temperature = <75000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
+				cpu0_alert1: trip-point1 {
+					temperature = <85000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
+				cpu0_crit: cpu-crit {
+					temperature = <110000>;
+					hysteresis = <1000>;
+					type = "critical";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&cpu0_alert0>;
+					cooling-device = <&fan THERMAL_NO_LIMIT 128>;
+				};
+
+				map1 {
+					trip = <&cpu0_alert1>;
+					cooling-device = <&fan 128 THERMAL_NO_LIMIT>;
+				};
+			};
+		};
+
+		cpu1-thermal {
+			polling-delay-passive = <250>;
+			polling-delay = <1000>;
+
+			thermal-sensors = <&tsens0 2>;
+
