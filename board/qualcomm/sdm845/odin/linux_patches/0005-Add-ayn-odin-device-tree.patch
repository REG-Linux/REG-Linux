+
+/* SD Card slot */
+&sdhc_2 {
+	status = "okay";
+
+	vmmc-supply = <&vreg_l21a_2p95>;
+	vqmmc-supply = <&vreg_l13a_2p95>;
+
+	cd-gpios = <&tlmm 126 GPIO_ACTIVE_LOW>;
+
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&sdc2_on &sdc2_cd>;
+	pinctrl-1 = <&sdc2_off>;
+
+	bus-width = <4>;
+	no-sdio;
+	no-mmc;
+};
+
+/* Analog input devices (sticks and triggers) via ADC */
+&pm8998_adc {
+	/* Left stick X-axis */
+	adc-chan@12 {
+		reg = <ADC5_GPIO3>;
+		qcom,decimation = <0>;
+		qcom,pre-scaling = <1 1>;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+		qcom,avg-samples = <1>;
+		label = "left_stick_x";
+	};
+
+	/* Left stick Y-axis */
+	adc-chan@13 {
+		reg = <ADC5_GPIO4>;
+		qcom,decimation = <0>;
+		qcom,pre-scaling = <1 1>;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+		qcom,avg-samples = <1>;
+		label = "left_stick_y";
+	};
+
+	/* Right stick X-axis */
+	adc-chan@14 {
+		reg = <ADC5_GPIO5>;
+		qcom,decimation = <0>;
+		qcom,pre-scaling = <1 1>;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+		qcom,avg-samples = <1>;
+		label = "right_stick_x";
+	};
+
+	/* Right stick Y-axis */
+	adc-chan@15 {
+		reg = <ADC5_GPIO6>;
+		qcom,decimation = <0>;
+		qcom,pre-scaling = <1 1>;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+		qcom,avg-samples = <1>;
+		label = "right_stick_y";
+	};
+
+	/* Left trigger (L2) */
+	adc-chan@16 {
+		reg = <ADC5_GPIO7>;
+		qcom,decimation = <0>;
+		qcom,pre-scaling = <1 1>;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+		qcom,avg-samples = <1>;
+		label = "left_trigger";
+	};
+
+	/* Right trigger (R2) */
+	adc-chan@97 {
+		reg = <ADC5_AMUX_THM2>;
+		qcom,decimation = <0>;
+		qcom,pre-scaling = <1 1>;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+		qcom,avg-samples = <1>;
+		label = "right_trigger";
+	};
+
+	/* XO thermistor */
+	adc-chan@4c {
+		reg = <ADC5_XO_THERM_100K_PU>;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+		qcom,pre-scaling = <1 1>;
+	};
+
+	/* MSM thermistor */
+	adc-chan@4d {
+		reg = <ADC5_AMUX_THM1_100K_PU>;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+		qcom,pre-scaling = <1 1>;
+	};
+
+	/* PA thermistor */
+	adc-chan@4f {
+		reg = <ADC5_AMUX_THM3_100K_PU>;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+		qcom,pre-scaling = <1 1>;
+	};
+
+	/* Quiet thermistor */
+	adc-chan@51 {
+		reg = <ADC5_AMUX_THM5_100K_PU>;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+		qcom,pre-scaling = <1 1>;
+	};
+};
+
+/* TLMM Pin configurations */
+&tlmm {
+	gpio-reserved-ranges = <0 4>, <81 4>;
+
+	fan_pins: fan-state {
+		fan-en-pins {
+			pins = "gpio44";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+			output-high;
+		};
+
+		fan-fg-pins {
+			pins = "gpio30";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-pull-down;
+			input-enable;
+		};
+	};
+
+	gamepad_pins: gamepad-state {
+		pins = "gpio0", "gpio3", "gpio7", "gpio22", "gpio24",
+		       "gpio25", "gpio26", "gpio40", "gpio41", "gpio49",
+		       "gpio52", "gpio87", "gpio91", "gpio92", "gpio95",
+		       "gpio96", "gpio116", "gpio122", "gpio124";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+		input-enable;
+	};
+
+	lt8912_pins: lt8912-state {
+		reset-pins {
+			pins = "gpio12";
+			function = "gpio";
+			drive-strength = <8>;
+			bias-disable;
+			output-high;
+		};
+
+		power-pins {
+			pins = "gpio8";
+			function = "gpio";
+			drive-strength = <8>;
+			bias-disable;
+			output-high;
+		};
+
+		enable-pins {
+			pins = "gpio13";
+			function = "gpio";
+			drive-strength = <8>;
+			bias-disable;
+			output-high;
+		};
+
+		hpd-pins {
+			pins = "gpio121";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-pull-down;
+			input-enable;
+		};
+	};
+
+	lt8912_micro_pins: lt8912-micro-state {
+		reset-pins {
+			pins = "gpio94";
+			function = "gpio";
+			drive-strength = <8>;
+			bias-disable;
+			output-high;
+		};
+
+		power-pins {
+			pins = "gpio93";
+			function = "gpio";
+			drive-strength = <8>;
+			bias-disable;
+			output-high;
+		};
+
+		enable-pins {
+			pins = "gpio97";
+			function = "gpio";
+			drive-strength = <8>;
+			bias-disable;
+			output-high;
+		};
+
+		hpd-pins {
+			pins = "gpio98";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-pull-down;
+			input-enable;
+		};
+	};
+
+	dp_hpd_pins: dp-hpd-state {
+		pins = "gpio98";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+		input-enable;
+	};
+
+	panel_reset_pins: panel-reset-state {
+		pins = "gpio6";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-disable;
+		output-high;
+	};
+
+	panel_enable_pins: panel-enable-state {
+		pins = "gpio120";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-disable;
+		output-high;
+	};
+
+	sdc2_on: sdc2-on-state {
+		clk-pins {
+			pins = "sdc2_clk";
+			bias-disable;
+			drive-strength = <16>;
+		};
+
+		cmd-pins {
+			pins = "sdc2_cmd";
+			bias-pull-up;
+			drive-strength = <10>;
+		};
+
+		data-pins {
+			pins = "sdc2_data";
+			bias-pull-up;
+			drive-strength = <10>;
+		};
+	};
+
+	sdc2_off: sdc2-off-state {
+		clk-pins {
+			pins = "sdc2_clk";
+			bias-disable;
+			drive-strength = <2>;
+		};
+
+		cmd-pins {
+			pins = "sdc2_cmd";
+			bias-pull-up;
+			drive-strength = <2>;
+		};
+
+		data-pins {
+			pins = "sdc2_data";
+			bias-pull-up;
+			drive-strength = <2>;
+		};
+	};
+
+	sdc2_cd: sdc2-cd-state {
+		pins = "gpio126";
+		function = "gpio";
+		bias-pull-up;
+		drive-strength = <2>;
+		input-enable;
+	};
+
+	ts_int_active: ts-int-active-state {
+		pins = "gpio125";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-up;
+		input-enable;
+	};
+
+	ts_reset_active: ts-reset-active-state {
+		pins = "gpio104";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-disable;
+		output-high;
+	};
+
+	usb_boost_en: usb-boost-en-state {
+		pins = "gpio129";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+		output-low;
+	};
+
+	usb_3v3_en: usb-3v3-en-state {
+		pins = "gpio128";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+		output-high;
+	};
+
+	usb_1v2_en: usb-1v2-en-state {
+		pins = "gpio135";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+		output-high;
+	};
+
+	/* WCN3990 WiFi/BT enable pins */
+	wcn3990_wlan_en: wcn3990-wlan-en-state {
+		pins = "gpio52";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+		output-low;
+	};
+
+	wcn3990_bt_en: wcn3990-bt-en-state {
+		pins = "gpio83";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+		output-low;
+	};
+
+	/* WCD9340 codec interrupt */
+	wcd_intr_default: wcd-intr-default-state {
+		pins = "gpio54";
+		function = "gpio";
+		input-enable;
+		bias-pull-down;
+		drive-strength = <2>;
+	};
+
+	/* Speaker amplifier power down pins */
+	spkr_1_sd_n: spkr-1-sd-n-state {
+		pins = "gpio89";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+		output-low;
+	};
+
+	spkr_2_sd_n: spkr-2-sd-n-state {
+		pins = "gpio90";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+		output-low;
+	};
+
+	/* Quaternary MI2S pins */
+	quat_mi2s_active: quat-mi2s-active-state {
+		pins = "gpio58", "gpio59";
+		function = "qua_mi2s";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	quat_mi2s_sd0_active: quat-mi2s-sd0-active-state {
+		pins = "gpio60";
+		function = "qua_mi2s";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	quat_mi2s_sd1_active: quat-mi2s-sd1-active-state {
+		pins = "gpio61";
+		function = "qua_mi2s";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	/* Tertiary MI2S for HDMI audio (LT8912B I2S input) */
+	tert_mi2s_active: tert-mi2s-active-state {
+		pins = "gpio75", "gpio76";
+		function = "ter_mi2s";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	tert_mi2s_sd0_active: tert-mi2s-sd0-active-state {
+		pins = "gpio77";
+		function = "ter_mi2s";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	/* Primary MI2S for micro HDMI audio */
+	pri_mi2s_active: pri-mi2s-active-state {
+		pins = "gpio65", "gpio66";
+		function = "pri_mi2s";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	pri_mi2s_sd0_active: pri-mi2s-sd0-active-state {
+		pins = "gpio67";
+		function = "pri_mi2s";
+		drive-strength = <8>;
+		bias-disable;
+	};
+};
