#
# REG-Linux specific kernel configuration fragment for L4T
# Applied on top of the full L4T kernel config (linux-l4t-defconfig.config)
#

# Ensure firmware loading support
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_FW_LOADER_COMPRESS=y

# DRM framebuffer support for early boot display
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Squashfs support for REG-Linux rootfs
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_LZ4=y

# Overlay filesystem
CONFIG_OVERLAY_FS=y

# FUSE support (for user-space filesystems)
CONFIG_FUSE_FS=y

# VFAT support for boot partition
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# ext4 for userdata partition
CONFIG_EXT4_FS=y

# USB mass storage
CONFIG_USB_STORAGE=y

# Input drivers for gamepads
CONFIG_INPUT_JOYDEV=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# Joystick interface
CONFIG_INPUT_JOYSTICK=y

# Namespaces (for containers/sandboxing)
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# CGROUP support
CONFIG_CGROUPS=y

# tmpfs
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# inotify
CONFIG_INOTIFY_USER=y

# signalfd/eventfd/timerfd
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_EPOLL=y

# devtmpfs for udev-less boot
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
