#!/bin/sh

# NVIDIA Tegra platform initialization

case "$1" in
    start)
        # Set CPU frequency governor to schedutil for better performance
        for cpu in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
            [ -f "${cpu}" ] && echo "schedutil" > "${cpu}" 2>/dev/null
        done

        # Load Nouveau GPU driver
        modprobe nouveau 2>/dev/null

        # Load Tegra audio modules
        modprobe snd_soc_tegra210_ahub 2>/dev/null
        modprobe snd_soc_tegra210_i2s 2>/dev/null
        modprobe snd_soc_tegra210_admaif 2>/dev/null
        ;;
    stop)
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac

exit 0
