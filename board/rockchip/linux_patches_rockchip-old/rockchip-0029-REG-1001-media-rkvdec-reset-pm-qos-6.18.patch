+      - const: niu_h
+
 required:
   - compatible
   - reg
@@ -103,6 +115,8 @@ required:
   - clocks
   - clock-names
   - power-domains
+  - resets
+  - reset-names
 
 allOf:
   - if:
@@ -158,6 +172,11 @@ examples:
         clock-names = "axi", "ahb", "cabac", "core";
         power-domains = <&power RK3399_PD_VDU>;
         iommus = <&vdec_mmu>;
