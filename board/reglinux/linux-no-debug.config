# Strip kernel debug/verbose knobs for non-debug (DEBUG_BUILD=n) builds.
# Appended to BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES by the top-level Makefile
# for every target when DEBUG_BUILD=n.
#
# Only options that affect kernel-internal diagnostics are disabled here.
# Userspace-visible debug surfaces are deliberately left alone:
#   DEBUG_FS       (mesa, GPU drivers, sysfs-equivalents)
#   FTRACE/KPROBES (perf, bpftrace, lttng, eBPF tooling)
#   PROFILING      (perf events)
#   DYNAMIC_DEBUG  (runtime dyndbg= overrides)

# Master + image-size wins
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_KGDB is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_DEBUG_BUGVERBOSE is not set
# CONFIG_DEBUG_LIST is not set
# CONFIG_DEBUG_ALIGN_RODATA is not set
# CONFIG_STACKTRACE is not set
# CONFIG_FAULT_INJECTION is not set

# Log noise
# CONFIG_PRINTK_TIME is not set
# CONFIG_SYMBOLIC_ERRNAME is not set
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=4

# Subsystem verbose modes (no API impact)
# CONFIG_SND_VERBOSE_PROCFS is not set
# CONFIG_CIFS_DEBUG is not set
# CONFIG_ATA_VERBOSE_ERROR is not set
# CONFIG_SCSI_LOGGING is not set
