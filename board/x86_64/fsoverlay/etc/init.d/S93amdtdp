#!/bin/dash

log="/userdata/system/logs/amd-tdp.log"

case "$1" in
    start) ;;
    stop) exit 0 ;;
    *) echo "Usage: $0 {start|stop}"; exit 1 ;;
esac

# Only AMD CPUs are handled.
if ! lscpu | grep -q AuthenticAMD; then
    echo "Authentic AMD CPU not found, exiting TDP..."
    exit 1
fi

# Query ryzenadj once and reuse its output.
info=$(ryzenadj -i 2>/dev/null)
if echo "$info" | head -n 1 | grep -q "unsupported model"; then
    echo "Supported AMD Processor NOT found for TDP..."
    exit 1
fi

max_tdp=$(echo "$info" | awk '/PPT LIMIT FAST/ { printf "%.0f", $6 }')

{
    echo ""
    echo "*** ------------------------------------- ***"
    echo ""
    echo "Supported Ryzen Mobile Processor found for TDP..."
} > "$log"

if [ -z "$max_tdp" ]; then
    echo "Maximum TDP is not defined, exiting TDP..." >> "$log"
    exit 1
fi
echo "Maximum reported TDP is $max_tdp Watts" >> "$log"

# Persist the detected maximum into /boot/system-boot.conf (ro by default) so
# regmsgd has it at its early, pre-userdata config load. Only write on change
# to avoid needless boot-partition writes.
if [ "$(sed -n 's/^system\.cpu\.tdp=//p' /boot/system-boot.conf 2>/dev/null | head -n 1)" != "$max_tdp" ]; then
    mount -o remount,rw /boot
    /usr/bin/regmsg systemconf setconfigkey /boot/system-boot.conf system.cpu.tdp "$max_tdp"
    mount -o remount,ro /boot
fi

# Apply the user's global TDP (a percentage of the maximum) when set and >= 10%.
tdp_percentage=$(printf "%.0f" "$(/usr/bin/regmsg systemconf getconfigkey global.tdp)" 2>/dev/null)
if [ "${tdp_percentage:-0}" -ge 10 ]; then
    tdp_value=$(awk -v m="$max_tdp" -v p="$tdp_percentage" 'BEGIN { printf "%.0f", m * p / 100 }')
    echo "Setting Ryzen Mobile Processor global TDP to $tdp_value Watts" >> "$log"
    /usr/bin/system-amd-tdp "$tdp_value"
else
    echo "No global TDP value set, using detected maximum!" >> "$log"
fi

exit 0
