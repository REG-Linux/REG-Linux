# DE10-Nano / Cyclone V SoC specific kernel options
# Applied ON TOP of MiSTer base defconfig + reglinux common fragment
# The common fragment already provides: SQUASHFS, OVERLAY_FS, ZRAM,
# USB_GADGET, SMB_SERVER, AUTOFS, UINPUT, PERF_EVENTS, CPU_FREQ

# FPGA Manager framework
CONFIG_FPGA=y
CONFIG_FPGA_MGR_SOCFPGA=y
CONFIG_FPGA_BRIDGE=y
CONFIG_SOCFPGA_FPGA_BRIDGE=y
CONFIG_ALTERA_FREEZE_BRIDGE=y
CONFIG_FPGA_REGION=y
CONFIG_OF_FPGA_REGION=y
CONFIG_OF_OVERLAY=y
CONFIG_OF_CONFIGFS=y

# Required for MiSTer userspace FPGA access via /dev/mem
CONFIG_DEVMEM=y

# SoC FPGA platform
CONFIG_ARCH_INTEL_SOCFPGA=y

# DWC2 USB controller (host mode)
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_HOST=y

# Ethernet (STMMAC/GMAC)
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_SOCFPGA=y

# I2C (for ADV7513 HDMI TX, RTCs, accelerometer)
CONFIG_I2C=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_GPIO=y

# RTCs on MiSTer I/O board
CONFIG_RTC_DRV_PCF8563=m
CONFIG_RTC_DRV_M41T80=m
CONFIG_RTC_DRV_DS1307=m

# MMC/SD card
CONFIG_MMC=y
CONFIG_MMC_DW=y

# DRM/KMS for HPS framebuffer (needed for Slint LinuxKMS + Mesa swrast)
CONFIG_DRM=y

# IPv6 — disabled in MiSTer defconfig, required by many REG Linux services
CONFIG_IPV6=y

# ZSMALLOC — dependency for ZRAM, not in MiSTer defconfig
CONFIG_ZSMALLOC=y

# LZ4 compression — needed for ZRAM and initrd
CONFIG_LZ4_COMPRESS=y
CONFIG_LZ4_DECOMPRESS=y
CONFIG_LZO_COMPRESS=y
CONFIG_LZO_DECOMPRESS=y
