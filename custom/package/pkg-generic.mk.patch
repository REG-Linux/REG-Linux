+# brcache in-flow restore: when this package's artifact is present locally (its
+# name is in $(BRCACHE_HITS)) run $(BRCACHE_RESTORE_CMD) <pkg> as an order-only
+# prereq of its first step, AFTER every dependency's restore. A cache hit's
+# deps are always hits (the key embeds dep keys), so their per-package dirs are
+# restored + accumulated first; this package's restore then cp-replays them.
+# The restore drops a `.brcached` marker; the guarded step recipes skip their
+# bodies and `make` rebuilds the stamp chain in order. No-op unless brcache is
+# active; misses (no marker, not in BRCACHE_HITS) build normally.
+ifneq ($$(BRCACHE_RESTORE_CMD),)
+ifneq ($$(filter $(1),$$(BRCACHE_HITS)),)
+$(1)-brcache-restore: $$(addsuffix -brcache-restore,$$($(2)_FINAL_DEPENDENCIES))
+	@$$(BRCACHE_RESTORE_CMD) $(1)
+$$($(2)_TARGET_SOURCE): | $(1)-brcache-restore
+$$($(2)_TARGET_RSYNC):  | $(1)-brcache-restore
+.PHONY: $(1)-brcache-restore
+endif
+endif
