+	mkdir -p $(@D)/$$ARCH/lib/runtime $(@D)/$$ARCH/lib/$$ARCH \
+		$(@D)/$$ARCH/gnuefi/$$ARCH && \
+	$(HOST_CONFIGURE_OPTS) $(MAKE) -C $(@D) $(HOST_GNU_EFI_MAKE_OPTS)
+endef
+
+define HOST_GNU_EFI_INSTALL_CMDS
+	$(HOST_CONFIGURE_OPTS) $(MAKE) -C $(@D) $(HOST_GNU_EFI_MAKE_OPTS) \
+		INSTALLROOT=$(HOST_DIR) install
+endef
