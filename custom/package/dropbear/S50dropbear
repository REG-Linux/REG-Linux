#!/bin/dash
# Starts dropbear sshd.

# REG-Linux
[ "$(/usr/bin/regmsg systemconf getconfigkey system.ssh.enabled)" = "0" ] && { echo "SSH services are disabled"; exit 0; }

# Allow customizations from config file
[ -r /etc/default/dropbear ] && . /etc/default/dropbear

start() {
	mkdir -p /userdata/system/.ssh
	chown root:root /userdata/system/.ssh
	chmod 700 /userdata/system/.ssh

	DROPBEAR_ARGS="${DROPBEAR_ARGS} -R -D /etc/dropbear"
	printf "Starting dropbear sshd: "
	umask 077
	{ start-stop-daemon -S -q -p /var/run/dropbear.pid --exec /usr/sbin/dropbear -- $DROPBEAR_ARGS && echo "OK"; } || echo "FAIL"
}

stop() {
	printf "Stopping dropbear sshd: "
	if start-stop-daemon -K -q -R 2 -n dropbear; then
		rm -f /var/run/dropbear.pid
		echo "OK"
	else
		echo "FAIL"
	fi
}

case "$1" in
	start)   start ;;
	stop)    stop ;;
	restart|reload)
		stop
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}" >&2
		exit 1
		;;
esac
