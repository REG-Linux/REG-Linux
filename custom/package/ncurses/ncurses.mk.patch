diff --git a/package/ncurses/ncurses.mk b/package/ncurses/ncurses.mk
index 00e1c0d424..ee3f23b888 100644
--- a/package/ncurses/ncurses.mk
+++ b/package/ncurses/ncurses.mk
@@ -18,6 +18,7 @@ NCURSES_CPE_ID_VENDOR = gnu
 NCURSES_CPE_ID_VERSION = $(NCURSES_VERSION_MAJOR)$(if $(NCURSES_SNAPSHOT_DATE),.$(NCURSES_SNAPSHOT_DATE))
 NCURSES_CONFIG_SCRIPTS = ncurses$(NCURSES_LIB_SUFFIX)6-config
 
+# reglinux - add the termlib option for RPCS3
 NCURSES_CONF_OPTS = \
 	--without-cxx \
 	--without-cxx-binding \
@@ -34,7 +35,12 @@ NCURSES_CONF_OPTS = \
 	--disable-stripping \
 	--with-pkg-config-libdir="/usr/lib/pkgconfig" \
 	$(if $(BR2_PACKAGE_NCURSES_TARGET_PROGS),,--without-progs) \
-	--without-manpages
+	--without-manpages \
+	--with-termlib=tinfo
+
+# reglinux - C23 (GCC 15+ default) has builtin bool, so configure skips
+# stdbool.h and curses.h then does "#define bool int", breaking C++ (gdb)
+NCURSES_CONF_ENV = cf_cv_header_stdbool_h=1
 
 ifeq ($(BR2_STATIC_LIBS),y)
 NCURSES_CONF_OPTS += --without-shared --with-normal
