#!/bin/sh

BOOT=/boot_root
NEWROOT=/new_root
OVL=/overlay_root
ROOTDEV="LABEL=REGLINUX"

msg(){ echo "[init] $*"; }

update() {
	n="$1"
	[ -e "$BOOT/boot/$n.update" ] || return
	mount -o remount,rw "$BOOT" || return 1
	mv "$BOOT/boot/$n.update" "$BOOT/boot/$n" || return 1
	[ -e "$BOOT/boot/overlay" ] && mv "$BOOT/boot/overlay" "$BOOT/boot/overlay.old"
	touch "$BOOT/REG_UPDATE"
	mount -o remount,ro "$BOOT"
}

parse_cmdline() {
	read -r cmd < /proc/cmdline
	for p in $cmd; do
		case "$p" in
			root=UUID=*) ROOTDEV="${p#root=}" ;;
			dev=*)       ROOTDEV="${p#dev=}" ;;
			label=*)     ROOTDEV="LABEL=${p#label=}" ;;
			uuid=*)      ROOTDEV="UUID=${p#uuid=}" ;;
		esac
	done
}

wait_root() {
	while ! mount -o ro "$ROOTDEV" "$BOOT" 2>/dev/null; do
		msg "Waiting for root device $ROOTDEV"
		sleep 1
	done
}

mount_root() {
	mount -t tmpfs -o size=32M tmpfs "$OVL" || return 1
	mkdir -p "$OVL/base" "$OVL/firmware" "$OVL/modules" "$OVL/upper" "$OVL/work" "$OVL/saved" || return 1

	# Select base rootfs
	if [ -f "$BOOT/REG_UPDATE" ] || [ -f "$BOOT/REG_RESCUE" ]; then
		ROOTFS="$BOOT/boot/rescue"
	else
		ROOTFS="$BOOT/boot/reglinux"
	fi
	mount "$ROOTFS" "$OVL/base" || return 1
	mount "$BOOT/boot/modules"  "$OVL/modules"
	mount "$BOOT/boot/firmware" "$OVL/firmware"

	UPPERDIR="$OVL/upper"
	WORKDIR="$OVL/work"

	# Persistent overlay: remount /boot rw only to open the ext4 file O_RDWR
	# for the loop device, then immediately remount /boot ro.  The loop driver
	# keeps its rw fd, so all overlayfs writes go directly to disk.
	if [ -f "$BOOT/boot/overlay" ]; then
		if mount -o remount,rw "$BOOT" 2>/dev/null; then
			if mount -o rw "$BOOT/boot/overlay" "$OVL/saved" 2>/dev/null; then
				mkdir -p "$OVL/saved/upper" "$OVL/saved/work"
				UPPERDIR="$OVL/saved/upper"
				WORKDIR="$OVL/saved/work"
			fi
			mount -o remount,ro "$BOOT"
		fi
	fi

	# Mount overlayfs
	mount -t overlay overlay -o "rw,lowerdir=$OVL/firmware:$OVL/modules:$OVL/base,upperdir=$UPPERDIR,workdir=$WORKDIR" "$NEWROOT" 2>/dev/null || return 1
}

boot() {
	mkdir -p "$BOOT" "$NEWROOT" "$OVL" /proc /sys /dev
	mount -t proc proc /proc
	mount -t sysfs sysfs /sys
	mount -t devtmpfs devtmpfs /dev

	parse_cmdline
	wait_root || return 1

	update modules
	update firmware
	update reglinux
	update rescue

	mount_root || return 1

	mkdir -p "$NEWROOT/boot" "$NEWROOT/overlay" "$NEWROOT/dev" "$NEWROOT/sys" "$NEWROOT/proc"
	mount --move "$BOOT" "$NEWROOT/boot"
	mount --move "$OVL"  "$NEWROOT/overlay"
	mount --move /dev    "$NEWROOT/dev"
	mount --move /sys    "$NEWROOT/sys"
	mount --move /proc   "$NEWROOT/proc"

	exec switch_root "$NEWROOT" /sbin/init
}

boot || { msg "Boot failed"; exec sh; }
