From 002-no-stb-cmake: Remove stb find_package requirement

The stb library is header-only and installed system-wide.
This patch removes the CMake find_package requirement since
stb headers are already available via STB_INCLUDE_DIR.

---
diff --git a/apps/ymir-sdl3/CMakeLists.txt b/apps/ymir-sdl3/CMakeLists.txt
index 8a7b3c4..9f2e1d5 100644
--- a/apps/ymir-sdl3/CMakeLists.txt
+++ b/apps/ymir-sdl3/CMakeLists.txt
@@ -357,7 +357,7 @@ find_package(fmt CONFIG REQUIRED)
 find_package(rtmidi CONFIG REQUIRED)
 find_package(SDL3 CONFIG REQUIRED)
-find_package(Stb REQUIRED)
+#find_package(Stb REQUIRED)
 find_package(tomlplusplus CONFIG REQUIRED)

 target_include_directories(ymir-sdl3
