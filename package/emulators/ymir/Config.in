config BR2_PACKAGE_YMIR
    bool "ymir"
    depends on BR2_PACKAGE_CLANG
    depends on BR2_PACKAGE_HAS_LIBEGL
    depends on BR2_x86_64 || BR2_aarch64
    select BR2_PACKAGE_CEREAL
    select BR2_PACKAGE_CXXOPTS
    select BR2_PACKAGE_DATE
    select BR2_PACKAGE_FMT
    select BR2_PACKAGE_JSON_FOR_MODERN_CPP
    select BR2_PACKAGE_LIBCURL
    select BR2_PACKAGE_LIBXKBCOMMON
    select BR2_PACKAGE_NGHTTP3
    select BR2_PACKAGE_RTMIDI
    select BR2_PACKAGE_SDL3
    select BR2_PACKAGE_SEMVER
    select BR2_PACKAGE_STB
    select BR2_PACKAGE_TOMLPLUSPLUS
    select BR2_PACKAGE_WAYLAND
    select BR2_PACKAGE_WAYLAND_PROTOCOLS
    select BR2_PACKAGE_ZSTD
    select BR2_PACKAGE_MINIZIP_ZLIB

    help
      A work-in-progress Sega Saturn emulator.

      Features:
      - Sega Saturn emulation with accurate timing
      - SDL3 frontend for Wayland/X11
      - OpenGL/Vulkan graphics backends
      - CHD, BIN+CUE, IMG+CCD, MDF+MDS, ISO support
      - Requires Sega Saturn IPL BIOS

      https://github.com/StrikerX3/Ymir
