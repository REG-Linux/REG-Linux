+bool mVUIsReservedCOP2(int hostreg)
+{
+	// gprF1 through 3 is not correctly used in COP2 mode.
+	return (hostreg == gprT1.GetCode() || hostreg == gprT2.GetCode() || hostreg == gprF0.GetCode());
+}
