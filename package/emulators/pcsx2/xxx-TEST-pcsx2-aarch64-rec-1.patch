+static void recDSLL_const()
+{
+	g_cpuConstRegs[_Rd_].UD[0] = (u64)(g_cpuConstRegs[_Rt_].UD[0] << _Sa_);
+}
+
+static void recDSLLs_(int info, int sa)
+{
+	pxAssert(!(info & PROCESS_EE_XMM));
