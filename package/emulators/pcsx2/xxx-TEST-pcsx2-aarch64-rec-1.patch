+mVUop(mVU_XGKICK)
+{
+	pass1
+	{
+		if (isVU0)
+		{
+			mVUlow.isNOP = true;
+			return;
+		}
+		mVUanalyzeXGkick(mVU, _Is_, 1);
+	}
+		pass2
+	{
+		if (CHECK_XGKICKHACK)
+		{
+			mVUlow.kickcycles = 99;
+			mVU_XGKICK_SYNC(mVU, true);
+			mVUlow.kickcycles = 0;
