+        armAsm->Sub(regd, regd, armLoad64(PTR_CPU(cpuRegs.GPR.r[_Rt_].SD[0])));
+    }
+
+	// emitter will eliminate redundant moves.
+//	xMOV(xRegister64(EEREC_D), regd);
+    armAsm->Mov(a64::XRegister(EEREC_D), regd);
