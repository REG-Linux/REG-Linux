+#define REC_FUNC(f) \
+	void rec##f() \
+	{ \
+		recCall(Interp::f); \
+	}
+
+#define REC_FUNC_DEL(f, delreg) \
+	void rec##f() \
+	{ \
+		if ((delreg) > 0) \
+			_deleteEEreg(delreg, 1); \
+		recCall(Interp::f); \
+	}
+
+#define REC_SYS(f) \
