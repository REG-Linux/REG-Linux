+}
+
+// Mark reserved FPU reg as needed. It won't be evicted anymore.
+// You must use _clearNeededXMMregs to clear the flag
+void _addNeededFPtoXMMreg(int fpreg)
+{
+	for (auto & xmmreg : xmmregs)
+	{
+		if (xmmreg.inuse == 0)
+			continue;
+		if (xmmreg.type != XMMTYPE_FPREG)
+			continue;
+		if (xmmreg.reg != fpreg)
