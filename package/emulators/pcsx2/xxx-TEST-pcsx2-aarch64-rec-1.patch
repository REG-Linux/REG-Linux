+static u32 GetAllocatedGPRBitmask()
+{
+	u32 i, mask = 0;
+	for (i = 0; i < iREGCNT_GPR; ++i)
+	{
+		if (x86regs[i].inuse)
+			mask |= (1u << i);
+	}
+	return mask;
+}
+
+static u32 GetAllocatedXMMBitmask()
+{
+	u32 i, mask = 0;
+	for (i = 0; i < iREGCNT_XMM; ++i)
+	{
+		if (xmmregs[i].inuse)
+			mask |= (1u << i);
+	}
+	return mask;
+}
