+		case PROCESS_EE_S:
+			//Console.WriteLn("FPU: DIV case 1");
+//			xMOVSS(xRegisterSSE(EEREC_D), xRegisterSSE(EEREC_S));
+            armAsm->Mov(regED.S(), 0, a64::QRegister(EEREC_S).S(), 0);
