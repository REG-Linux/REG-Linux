+			if (!(pinst->regs[reg] & EEINST_USED)) \
+				pinst->regs[reg] |= EEINST_LASTUSE; \
+			prev->regs[reg] = (EEINST_LIVE | EEINST_USED); \
+			pinst->regs[reg] = (pinst->regs[reg] & ~EEINST_XMM) | EEINST_USED; \
+			_recFillRegister(*pinst, XMMTYPE_GPRREG, reg, 0); \
