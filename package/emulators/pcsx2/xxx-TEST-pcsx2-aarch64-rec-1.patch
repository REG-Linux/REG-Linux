+	recMULTsuper(info, false, false, PROCESS_CONSTT);
+}
+
+// don't specify XMMINFO_WRITELO or XMMINFO_WRITEHI, that is taken care of
+EERECOMPILE_CODERC0(MULTU, XMMINFO_READS | XMMINFO_READT | (_Rd_ ? XMMINFO_WRITED : 0));
