+/*********************************************************
+* Register mult/div & Register trap logic                *
+* Format:  OP rs, rt                                     *
+*********************************************************/
+#ifndef MULTDIV_RECOMPILE
+
+REC_FUNC_DEL(MULT, _Rd_);
