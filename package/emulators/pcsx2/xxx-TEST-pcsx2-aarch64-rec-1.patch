+	{
+		if (_Rt_ == 0)
+		{
+			xPXOR(xRegisterSSE(EEREC_D), xRegisterSSE(EEREC_D));
+		}
+		else
+		{
+			xPSHUF.D(xRegisterSSE(EEREC_D), xRegisterSSE(EEREC_T), 0x88);
+			xPMOVSX.DQ(xRegisterSSE(EEREC_D), xRegisterSSE(EEREC_D));
