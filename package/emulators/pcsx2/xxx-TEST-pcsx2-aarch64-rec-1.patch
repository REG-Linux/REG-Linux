+        _eeMoveGPRtoR(ECX, _Rs_);
+		if (_Imm_ != 0) {
+//            xADD(arg1regd, _Imm_);
+            armAsm->Add(ECX, ECX, _Imm_);
+        }
+
+		vtlb_DynGenReadNonQuad(32, false, true, ECX.GetCode(), alloc_cb);
+	}
+
+	EE::Profiler.EmitOp(eeOpcode::LWC1);
+#endif
