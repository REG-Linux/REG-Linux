diff --git a/src/osdep/crtemu.h b/src/osdep/crtemu.h
index 4a6d9d38..0146866e 100644
--- a/src/osdep/crtemu.h
+++ b/src/osdep/crtemu.h
@@ -389,17 +389,34 @@ static CRTEMU_GLuint crtemu_internal_build_shader( crtemu_t* crtemu, char const*
     fs_preamble = "precision highp float;\n";
 #else
     if (is_gles) {
-        // Use mediump on mobile GPUs for better performance (2-3x faster on VideoCore)
-        // highp is slow on mobile tile-based GPUs; mediump is sufficient for CRT effects
-        if (crtemu->is_mobile_gpu) {
-            vs_preamble = "#version 300 es\nprecision mediump float;\n";
-            fs_preamble = "#version 300 es\nprecision mediump float;\n";
+        // Detect GLES major version for shader preamble selection
+        int gles_major = 0;
+        if (gl_ver_str) {
+            const char* gv = strstr(gl_ver_str, "OpenGL ES ");
+            if (gv) { gv += 10; gles_major = atoi(gv); }
+        }
+        if (gles_major >= 3) {
+            // Use mediump on mobile GPUs for better performance (2-3x faster on VideoCore)
+            // highp is slow on mobile tile-based GPUs; mediump is sufficient for CRT effects
+            if (crtemu->is_mobile_gpu) {
+                vs_preamble = "#version 300 es\nprecision mediump float;\n";
+                fs_preamble = "#version 300 es\nprecision mediump float;\n";
+            } else {
+                vs_preamble = "#version 300 es\nprecision highp float;\n";
+                fs_preamble = "#version 300 es\nprecision highp float;\n";
+            }
+            vs_defines = "#define attribute in\n#define varying out\n";
+            fs_defines = "#define varying in\n#define texture2D texture\n#define gl_FragColor fragColor\nout vec4 fragColor;\n";
         } else {
-            vs_preamble = "#version 300 es\nprecision highp float;\n";
-            fs_preamble = "#version 300 es\nprecision highp float;\n";
+            // GLES2: use #version 100 with appropriate precision
+            if (crtemu->is_mobile_gpu) {
+                vs_preamble = "#version 100\nprecision mediump float;\n";
+                fs_preamble = "#version 100\nprecision mediump float;\n";
+            } else {
+                vs_preamble = "#version 100\nprecision highp float;\n";
+                fs_preamble = "#version 100\nprecision highp float;\n";
+            }
         }
-        vs_defines = "#define attribute in\n#define varying out\n";
-        fs_defines = "#define varying in\n#define texture2D texture\n#define gl_FragColor fragColor\nout vec4 fragColor;\n";
     } else if (is_core) {
         vs_preamble = "#version 330 core\n";
         fs_preamble = "#version 330 core\n";
diff --git a/src/osdep/gl_platform.cpp b/src/osdep/gl_platform.cpp
index 990a3cc8..07d9f7aa 100644
--- a/src/osdep/gl_platform.cpp
+++ b/src/osdep/gl_platform.cpp
@@ -10,7 +10,7 @@
 #include "gl_platform.h"
 #include "sysdeps.h"
 
-#if !defined(__ANDROID__) && !defined(USE_GLES3)
+#if !defined(__ANDROID__) && !defined(USE_GLES3) && !defined(USE_GLES2)
 // Desktop: Define the function pointers
 PFNGLGENVERTEXARRAYSPROC glp_GenVertexArrays = nullptr;
 PFNGLBINDVERTEXARRAYPROC glp_BindVertexArray = nullptr;
@@ -137,10 +137,14 @@ bool gl_platform_init()
 }
 
 #else
-// Android: Functions are provided by GLES3, nothing to load
+// GLES2/GLES3/Android: Functions are provided directly, nothing to load
 bool gl_platform_init()
 {
+#if defined(USE_GLES2)
+	write_log("OpenGL ES 2.0 - no extension loading needed\n");
+#else
 	write_log("OpenGL ES 3.0 - no extension loading needed\n");
+#endif
 	return true;
 }
 #endif // __ANDROID__
diff --git a/src/osdep/gl_platform.h b/src/osdep/gl_platform.h
index 0751a4c0..b516c035 100644
--- a/src/osdep/gl_platform.h
+++ b/src/osdep/gl_platform.h
@@ -14,10 +14,21 @@
 #ifdef USE_OPENGL
 
 #if defined(__ANDROID__) || defined(USE_GLES3)
-// Android/GLES3: Functions are provided by <GLES3/gl3.h>
+// Android/GLES3: All functions are provided directly
 #include <GLES3/gl3.h>
 #include <SDL3/SDL_opengles2.h>
 
+#elif defined(USE_GLES2)
+// GLES2: Core functions provided directly, VAOs via OES extension
+#include <GLES2/gl2.h>
+#include <GLES2/gl2ext.h>
+#include <SDL3/SDL_opengles2.h>
+// Map VAO calls to OES variants (available on most GLES2 drivers)
+#define glGenVertexArrays glGenVertexArraysOES
+#define glBindVertexArray glBindVertexArrayOES
+#define glDeleteVertexArrays glDeleteVertexArraysOES
+#define glIsVertexArray glIsVertexArrayOES
+
 #else
 // Desktop: Need to load extension functions dynamically
 #include <SDL3/SDL_opengl.h>
