config BR2_PACKAGE_AZAHAR
    bool "azahar"
    depends on BR2_x86_64 || BR2_aarch64
    select BR2_PACKAGE_REGLINUX_QT6
    select BR2_PACKAGE_FMT
    select BR2_PACKAGE_BOOST
    select BR2_PACKAGE_FFMPEG
    select BR2_PACKAGE_SDL2
    select BR2_PACKAGE_FDK_AAC
    select BR2_PACKAGE_CUBEB
    select BR2_PACKAGE_OPENSSL
    select BR2_PACKAGE_LIBZIP
    select BR2_PACKAGE_LZ4
    select BR2_PACKAGE_ZSTD

    help
      Azahar is an open-source 3DS emulator project based on Citra.

      Features:
      - Nintendo 3DS emulation
      - OpenGL and Vulkan graphics backends
      - Qt6 frontend (SDL2 for input)
      - Cubeb audio backend
      - Online multiplayer support
      - Controller support via SDL2

      https://github.com/azahar-emu/azahar
