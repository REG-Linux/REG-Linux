config BR2_PACKAGE_CEMU
    bool "cemu"
    depends on BR2_x86_64 || BR2_aarch64
    select BR2_PACKAGE_SDL2
    select BR2_PACKAGE_FMT
    select BR2_PACKAGE_LIBCURL
    select BR2_PACKAGE_PUGIXML
    select BR2_PACKAGE_RAPIDJSON
    select BR2_PACKAGE_BOOST
    select BR2_PACKAGE_LIBZIP
    select BR2_PACKAGE_GLSLANG
    select BR2_PACKAGE_ZLIB
    select BR2_PACKAGE_ZSTD
    select BR2_PACKAGE_GLM
    select BR2_PACKAGE_LIBPNG
    select BR2_PACKAGE_LIBUSB
    select BR2_PACKAGE_WXWIDGETS
    select BR2_PACKAGE_UPOWER                   # required by some cemuhook servers
    select BR2_PACKAGE_HIDAPI                   # required for Wiimote support
    select BR2_PACKAGE_BLUEZ5_UTILS             # required for Wiimote support
    select BR2_PACKAGE_WEBP
    select BR2_PACKAGE_WEBP_DEMUX
    select BR2_PACKAGE_CUBEB                    # Audio backend
    help
      Cemu is a Wii U emulator that now runs natively on Linux.

      Features:
      - Wii U emulation (x86_64 and aarch64)
      - OpenGL and Vulkan graphics backends
      - SDL2 controller support
      - Wiimote support via HIDAPI + BlueZ
      - Cubeb audio backend
      - GameProfile support
      - CemuHook controller support

      https://cemu.info/
