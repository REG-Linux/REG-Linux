+	trigger = "NO_USE_BGFX_KHRONOS",
+	description = "Skip including bgfx 3rdparty khronos headers (rely on system ones)",
+}
+
+newoption {
 	trigger = "DEBUG_DIR",
 	description = "Default directory for debugger.",
 }
--- a/scripts/src/3rdparty.lua	2026-08-12 10:40:47.000000000 +0100
+++ b/scripts/src/3rdparty.lua	2026-08-13 21:28:00.509912520 +0100
@@ -1457,9 +1457,14 @@
 		MAME_DIR .. "3rdparty/bx/include",
