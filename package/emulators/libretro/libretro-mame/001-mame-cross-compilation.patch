From: REG-Linux <cjom@reglinux.org>
Subject: [PATCH] build: cross-compilation fixes

Lets the libretro MAME build be driven by an external toolchain:
OVERRIDE_STRIP and CROSS_ARCH pass-through in the makefile, an arm64
linux-gcc configuration and STRIP postbuild in the GENie toolchain, a
NO_USE_BGFX_KHRONOS switch, NO_USE_PULSEAUDIO for the retro OSD, and
minimp3 HAVE_SSE guards.

Refreshed against lrmame0289 (all hunks previously applied with fuzz).

--- a/3rdparty/minimp3/minimp3.h	2026-07-31 18:42:46.000000000 +0100
+++ b/3rdparty/minimp3/minimp3.h	2026-08-13 21:38:46.468769074 +0100
@@ -84,6 +84,10 @@
 #define MINIMP3_MIN(a, b)           ((a) > (b) ? (b) : (a))
 #define MINIMP3_MAX(a, b)           ((a) < (b) ? (b) : (a))
 
+#ifndef HAVE_SSE
+#define HAVE_SSE 0
+#endif
+
 #if !defined(MINIMP3_NO_SIMD)
 
 #if !defined(MINIMP3_ONLY_SIMD) && (defined(_M_X64) || defined(__x86_64__) || defined(__aarch64__) || defined(_M_ARM64))
@@ -96,6 +100,9 @@
 #include <intrin.h>
 #endif /* defined(_MSC_VER) */
 #include <immintrin.h>
+#ifdef HAVE_SSE
+#undef HAVE_SSE
+#endif
 #define HAVE_SSE 1
 #define HAVE_SIMD 1
 #define VSTORE _mm_storeu_ps
@@ -899,6 +906,7 @@
 #endif
     }
 #endif /* HAVE_SIMD */
+    i = (n >> 2) << 2;
     for (; i < n; i++)
     {
         float a = left[i];
--- a/makefile	2026-07-31 18:42:46.000000000 +0100
+++ b/makefile	2026-08-13 21:38:46.468938910 +0100
@@ -33,6 +33,7 @@
 # SDL2_MULTIAPI = 1
 # NO_USE_MIDI = 1
 # NO_USE_PORTAUDIO = 1
+# NO_USE_BGFX_KHRONOS = 1
 # NO_USE_PULSEAUDIO = 1
 # NO_USE_PIPEWIRE = 1
 # USE_TAPTUN = 1
@@ -89,11 +90,13 @@
 # BUILDDIR = build
 # TARGETOS = windows
 # CROSS_BUILD = 1
+# CROSS_ARCH =
 # TOOLCHAIN =
 # OVERRIDE_CC = cc
 # OVERRIDE_CXX = c++
 # OVERRIDE_LD = ld
 # OVERRIDE_AR = ar
+# OVERRIDE_STRIP = strip
 
 # DEPRECATED = 0
 # LTO = 1
@@ -591,6 +594,12 @@
 AR := $(OVERRIDE_AR)
 endif
 endif
+ifdef OVERRIDE_STRIP
+PARAMS += --STRIP='$(OVERRIDE_STRIP)'
+ifndef CROSS_BUILD
+STRIP := $(OVERRIDE_STRIP)
+endif
+endif
 
 #-------------------------------------------------
 # sanity check the configuration
@@ -761,6 +770,10 @@
 PARAMS += --NO_USE_MIDI='$(NO_USE_MIDI)'
 endif
 
+ifdef NO_USE_BGFX_KHRONOS
+PARAMS += --NO_USE_BGFX_KHRONOS='$(NO_USE_BGFX_KHRONOS)'
+endif
+
 ifdef NO_USE_PORTAUDIO
 PARAMS += --NO_USE_PORTAUDIO='$(NO_USE_PORTAUDIO)'
 endif
--- a/scripts/genie.lua	2026-07-31 18:42:46.000000000 +0100
+++ b/scripts/genie.lua	2026-08-13 21:38:46.469057998 +0100
@@ -192,6 +192,11 @@
 }
 
 newoption {
+	trigger = "STRIP",
+	description = "STRIP replacement",
