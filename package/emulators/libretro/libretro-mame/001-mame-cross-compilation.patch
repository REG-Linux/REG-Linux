 	if _OPTIONS["NO_USE_PORTAUDIO"]=="1" then
 		defines {
 			"NO_USE_PORTAUDIO",
--- a/scripts/src/osd/retro_modules.lua	2026-07-31 18:42:46.000000000 +0100
+++ b/scripts/src/osd/retro_modules.lua	2026-08-13 21:38:46.469456422 +0100
@@ -119,6 +119,7 @@
 	defines {
         "NO_USE_MIDI",
         "NO_USE_PORTAUDIO",
