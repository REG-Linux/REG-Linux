--- a/platforms/libretro/Makefile
+++ b/platforms/libretro/Makefile
@@ -82,8 +82,32 @@
 		endif
 	else ifneq (,$(findstring rpi4_64,$(platform)))
 		PLATFORM_FLAGS += -march=armv8-a+crc+simd -mtune=cortex-a72
+	else ifneq (,$(findstring rpi4,$(platform)))
+		PLATFORM_FLAGS += -mcpu=cortex-a72 -mtune=cortex-a72
+	else ifneq (,$(findstring rpi5,$(platform)))
+		PLATFORM_FLAGS += -mcpu=cortex-a76 -mtune=cortex-a76
 	endif
 endif
+# RK3326
+ifneq (,$(findstring rk3326,$(platform)))
+	PLATFORM_FLAGS += -mcpu=cortex-a35 -mtune=cortex-a35
+endif
+# RK3399
+ifneq (,$(findstring rk3399,$(platform)))
+	PLATFORM_FLAGS += -mcpu=cortex-a72.cortex-a53 -mtune=cortex-a72.cortex-a53
+endif
+# RK3568
+ifneq (,$(findstring rk3568,$(platform)))
+	PLATFORM_FLAGS += -mcpu=cortex-a55 -mtune=cortex-a55
+endif
+# RK3588
+ifneq (,$(findstring rk3588,$(platform)))
+	PLATFORM_FLAGS += -mcpu=cortex-a76.cortex-a55 -mtune=cortex-a76.cortex-a55
+endif
+# S922X
+ifneq (,$(findstring s922x,$(platform)))
+	PLATFORM_FLAGS += -mcpu=cortex-a73.cortex-a53 -mtune=cortex-a73.cortex-a53
+endif
 # (armv7 a7, hard point, neon based) ### 
 # NESC, SNESC, C64 mini 
 else ifeq ($(platform), classic_armv7_a7)
