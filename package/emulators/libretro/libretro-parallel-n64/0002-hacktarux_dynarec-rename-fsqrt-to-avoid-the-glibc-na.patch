From 997f86f4928757e29f1ac194bd1c54829742a6d3 Mon Sep 17 00:00:00 2001
From: LibretroAdmin <LibretroAdmin@users.noreply.github.com>
Date: Sat, 6 Jun 2026 23:20:50 +0000
Subject: [PATCH 2/2] hacktarux_dynarec: rename fsqrt to avoid the glibc
 narrowing-math clash (fixes #797)

glibc 2.41 (with gcc 15) declares a narrowing-sqrt prototype
float fsqrt(double) in bits/mathcalls-narrow.h, pulled in via <math.h>.
The x86 hacktarux dynarec defines its own FPU opcode emitter
static INLINE void fsqrt(void) in assemble.h, which is included broadly
through recomp.h - so the build fails with 'conflicting types for
fsqrt' in any TU that sees both, e.g. cached_interp.c, on those
toolchains.

Rename the emitter (and its four call sites in hacktarux_dynarec.c) to
fsqrt_, matching the trailing-underscore convention already used right
below it for fabs_, which dodges the exact same <math.h> collision for
fabs. This is preferable to the blanket tree-wide sed suggested on the
issue, which would also rewrite unrelated assem_debug("fsqrt") log
strings and the separately-scoped new_dynarec emitters.

x86-only emitter, so no codegen change on the tested x64 ari64 path;
Conker (which uses FPU SQRT.S) and GoldenEye RAM hashes are
bit-identical.

[REG: re-applied at the device/ path (two call sites now); the rename
was lost in 48c11393
"core: reorganize src tree into next's device/ layout"]
---
 .../src/device/r4300/hacktarux_dynarec/assemble.h             | 2 +-
 .../src/device/r4300/hacktarux_dynarec/hacktarux_dynarec.c    | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/mupen64plus-core/src/device/r4300/hacktarux_dynarec/assemble.h b/mupen64plus-core/src/device/r4300/hacktarux_dynarec/assemble.h
index b350507c..125daab3 100644
--- a/mupen64plus-core/src/device/r4300/hacktarux_dynarec/assemble.h
+++ b/mupen64plus-core/src/device/r4300/hacktarux_dynarec/assemble.h
@@ -1222,7 +1222,7 @@ static osal_inline void fmul_preg64_qword(int reg64)
     put8(0x08 + reg64);
 }
 
-static osal_inline void fsqrt(void)
+static osal_inline void fsqrt_(void)
 {
     put8(0xD9);
     put8(0xFA);
diff --git a/mupen64plus-core/src/device/r4300/hacktarux_dynarec/hacktarux_dynarec.c b/mupen64plus-core/src/device/r4300/hacktarux_dynarec/hacktarux_dynarec.c
index 56d0c839..12d6749c 100644
--- a/mupen64plus-core/src/device/r4300/hacktarux_dynarec/hacktarux_dynarec.c
+++ b/mupen64plus-core/src/device/r4300/hacktarux_dynarec/hacktarux_dynarec.c
@@ -5226,7 +5226,7 @@ void gen_CP1_SQRT_S(struct r4300_core* r4300)
     gencheck_cop1_unusable(r4300);
     mov_xreg64_m64rel(RAX, (unsigned long long *)(&(r4300_cp1_regs_simple(&r4300->cp1))[r4300->recomp.dst->f.cf.fs]));
     fld_preg64_dword(RAX);
-    fsqrt();
+    fsqrt_();
     mov_xreg64_m64rel(RAX, (unsigned long long *)(&(r4300_cp1_regs_simple(&r4300->cp1))[r4300->recomp.dst->f.cf.fd]));
     fstp_preg64_dword(RAX);
 #endif
@@ -5243,7 +5243,7 @@ void gen_CP1_SQRT_D(struct r4300_core* r4300)
     gencheck_cop1_unusable(r4300);
     mov_xreg64_m64rel(RAX, (unsigned long long *)(&(r4300_cp1_regs_double(&r4300->cp1))[r4300->recomp.dst->f.cf.fs]));
     fld_preg64_qword(RAX);
-    fsqrt();
+    fsqrt_();
     mov_xreg64_m64rel(RAX, (unsigned long long *)(&(r4300_cp1_regs_double(&r4300->cp1))[r4300->recomp.dst->f.cf.fd]));
     fstp_preg64_qword(RAX);
 #endif
