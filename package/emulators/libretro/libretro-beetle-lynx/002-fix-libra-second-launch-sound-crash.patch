 static MDFN_Surface *surf;
 
+/* Libra (REG-Linux in-process player) keeps this core's .so mapped and
+ * retro_init()'d for the life of the process, reusing it across every game
+ * launch instead of doing a fresh dlopen. A function-local `static` in
+ * retro_run() would then leak the previous game's sample rate into the next
+ * game's first frame, so SoundFormatChanged never fires and the freshly
+ * constructed CSystem's Stereo_Buffer (mikbuf) never gets set_sample_rate()
+ * -- its Blip_Buffers stay unallocated and mix_stereo() dereferences a null
+ * buffer. Hoisted to file scope and reset in retro_load_game() so every new
+ * game re-triggers the buffer setup regardless of whether the rate itself
+ * changed. */
+static double last_sound_rate;
+
 static bool libretro_supports_option_categories = false;
 
