config BR2_PACKAGE_LIBRETRO_SUPERMODEL
	bool "libretro-supermodel"

	depends on BR2_INSTALL_LIBSTDCPP
	depends on (BR2_PACKAGE_HAS_LIBGLES || BR2_PACKAGE_HAS_LIBGL)
      help
        A libretro Sega Model 3 arcade emulator core.

	  http://www.libretro.com

comment "LIBRETRO_SUPERMODEL needs a toolchain w/ C++ and OpenGL ES or OpenGL"
	depends on !BR2_INSTALL_LIBSTDCPP || \
		(!BR2_PACKAGE_HAS_LIBGLES && !BR2_PACKAGE_HAS_LIBGL)
