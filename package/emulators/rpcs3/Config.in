config BR2_PACKAGE_RPCS3
	bool "rpcs3"
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_8
	select BR2_HOST_CMAKE_AT_LEAST_3_24
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_LLVM
	select BR2_PACKAGE_FFMPEG_SWSCALE
	select BR2_PACKAGE_LIBEVDEV
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_LIBPNG
	select BR2_PACKAGE_LIBGLEW
	select BR2_PACKAGE_LIBGLU
	select BR2_PACKAGE_LIBUSB
	select BR2_PACKAGE_LIBXML2
	select BR2_PACKAGE_MESA3D
	select BR2_PACKAGE_NCURSES
	select BR2_PACKAGE_OPENAL
	select BR2_PACKAGE_PUGIXML
	select BR2_PACKAGE_REGLINUX_QT6
	select BR2_PACKAGE_RTMIDI
	select BR2_PACKAGE_RTMPDUMP
	select BR2_PACKAGE_SDL3
	select BR2_PACKAGE_ZLIB
	select BR2_PACKAGE_ZSTD
	select BR2_PACKAGE_CUBEB
	select BR2_PACKAGE_LIBDRM
	select BR2_PACKAGE_WAYLAND
	select BR2_PACKAGE_LIBXKBCOMMON
	select BR2_PACKAGE_CLANG
	help
	  RPCS3 is a multi-platform open-source Sony PlayStation 3 emulator.

	  It supports both Windows and Linux platforms and features both OpenGL
	  and Vulkan renderers. RPCS3 was initiated on 23rd of May, 2011, by
	  DH and Hykem, and is still being actively developed to this day.

	  https://rpcs3.net/
