config BR2_PACKAGE_CLASSICUBE
	bool "classicube"
	depends on !BR2_STATIC_LIBS
	depends on BR2_PACKAGE_HAS_LIBGL || BR2_PACKAGE_HAS_LIBGLES
	select BR2_PACKAGE_SDL2
	select BR2_PACKAGE_GL4ES if !BR2_PACKAGE_HAS_LIBGL
	help
	  ClassiCube is a custom Minecraft Classic compatible client
	  written in C. Pure C, minimal dependencies.
	  Free — connects to ClassiCube.net servers.

	  https://github.com/ClassiCube/ClassiCube
