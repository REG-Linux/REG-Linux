config BR2_PACKAGE_CROMAGRALLY
	bool "cromagrally"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on !BR2_STATIC_LIBS
	depends on BR2_PACKAGE_HAS_LIBGL || BR2_PACKAGE_HAS_LIBGLES
	select BR2_PACKAGE_SDL2
	select BR2_PACKAGE_GL4ES if !BR2_PACKAGE_HAS_LIBGL
	help
	  Cro-Mag Rally is a caveman kart racing game by Pangea
	  Software, open-sourced by Jorio. All assets included.
	  Requires SDL3.

	  https://github.com/jorio/CroMagRally
