config BR2_PACKAGE_NANOSAUR2
	bool "nanosaur2"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on !BR2_STATIC_LIBS
	depends on BR2_PACKAGE_HAS_LIBGL || BR2_PACKAGE_HAS_LIBGLES
	select BR2_PACKAGE_SDL2
	select BR2_PACKAGE_LIBGL if BR2_PACKAGE_HAS_LIBGL
	select BR2_PACKAGE_GL4ES if !BR2_PACKAGE_HAS_LIBGL
	select BR2_PACKAGE_LIBGLES if BR2_PACKAGE_HAS_LIBGLES
	help
	  Nanosaur 2: Hatchling by Pangea Software, open-sourced
	  by Jorio. 3D dinosaur shooter. All assets included.
	  Requires SDL3.

	  https://github.com/jorio/Nanosaur2
