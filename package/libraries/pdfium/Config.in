config BR2_PACKAGE_PDFIUM_ARCH_SUPPORTS
	bool
	default y if BR2_arm
	default y if BR2_aarch64
	default y if BR2_x86_64
	default y if BR2_riscv && BR2_ARCH_IS_64

config BR2_PACKAGE_PDFIUM
	bool "PDFium (prebuilt binaries)"
	depends on BR2_PACKAGE_PDFIUM_ARCH_SUPPORTS
	depends on BR2_TOOLCHAIN_USES_GLIBC || BR2_TOOLCHAIN_USES_MUSL
	help
	  Installs the prebuilt PDFium shared library and headers from
	  https://github.com/bblanchon/pdfium-binaries (chromium/7557 release).
	  The package provides `libpdfium.so` for arm, AArch64, riscv64 and
	  x86_64 targets. Only glibc and musl toolchains are supported, and
	  shared libraries must be enabled on the target.
	  The archive is published under the MIT license (see LICENSE).
