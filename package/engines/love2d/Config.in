config BR2_PACKAGE_LOVE2D
	bool "love2d"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_PACKAGE_OPENAL_ARCH_SUPPORTS
	depends on BR2_PACKAGE_REGLINUX_LUAJIT_ARCH_SUPPORTS
	depends on BR2_TOOLCHAIN_HAS_THREADS_NPTL # openal
	depends on !BR2_STATIC_LIBS # SDL2
	depends on BR2_PACKAGE_HAS_LIBGL || BR2_PACKAGE_HAS_LIBGLES

	select BR2_PACKAGE_FREETYPE
	select BR2_PACKAGE_LIBMODPLUG
	select BR2_PACKAGE_LIBOGG
	select BR2_PACKAGE_LIBTHEORA
	select BR2_PACKAGE_LIBVORBIS
	select BR2_PACKAGE_MPG123
	select BR2_PACKAGE_OPENAL
	select BR2_PACKAGE_REGLINUX_LUAJIT
	select BR2_PACKAGE_SDL2
	select BR2_PACKAGE_ZLIB
	select BR2_PACKAGE_GL4ES if !BR2_PACKAGE_HAS_LIBGL
	help
	  LOVE is a free 2D game engine which enables easy game
	  creation in Lua. Games are packaged as .love files (Lua
	  scripts) which are fully architecture-independent.

	  https://love2d.org
	  https://github.com/love2d/love

comment "love2d needs OpenGL/GLES, C++, NPTL, dynamic libs, and luajit"
	depends on BR2_PACKAGE_OPENAL_ARCH_SUPPORTS
	depends on BR2_PACKAGE_REGLINUX_LUAJIT_ARCH_SUPPORTS
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS_NPTL \
		|| BR2_STATIC_LIBS \
		|| !(BR2_PACKAGE_HAS_LIBGL || BR2_PACKAGE_HAS_LIBGLES)
