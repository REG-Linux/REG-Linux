config BR2_PACKAGE_GMLOADER_NEXT
	bool "gmloader-next"
	depends on BR2_arm || BR2_aarch64
	depends on BR2_INSTALL_LIBSTDCPP
	depends on !BR2_STATIC_LIBS # SDL2
	select BR2_PACKAGE_SDL2
	select BR2_PACKAGE_ZLIB
	help
	  gmloader-next is a compatibility layer that loads Android
	  GameMaker runner libraries on ARM Linux. It enables running
	  GameMaker Studio games from their Android APK builds.

	  Game data files (.win/.droid) are architecture-independent.
	  Users must provide their own game APK files.

	  Note: ARM-only (loads ARM Android .so binaries).

	  https://github.com/JohnnyonFlame/gmloader-next

comment "gmloader-next needs ARM (arm/aarch64), C++, dynamic libs"
	depends on !(BR2_arm || BR2_aarch64) || !BR2_INSTALL_LIBSTDCPP \
		|| BR2_STATIC_LIBS
