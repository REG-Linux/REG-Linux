config BR2_PACKAGE_REGPLAYER
	bool "REG-Player"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on (BR2_PACKAGE_HAS_LIBGLES || BR2_PACKAGE_HAS_LIBGL)
	select BR2_PACKAGE_SDL3
	select BR2_PACKAGE_SDL3_IMAGE
	select BR2_PACKAGE_SDL3_TTF
	select BR2_PACKAGE_MPV
	select BR2_PACKAGE_TAGLIB
	select BR2_PACKAGE_LIBXMP
	select BR2_PACKAGE_LIBGME
	select BR2_PACKAGE_OPUSFILE
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_ALSA_UTILS
	select BR2_PACKAGE_ALSA_UTILS_AMIXER
	select BR2_PACKAGE_ZLIB
	help
	  XMB-style media player for REG-Linux handhelds.
	  Plays music (incl. trackers + chiptune), photos, video.
	  Default scan root: /userdata/medias.

	  https://github.com/REG-Linux/REG-Player

comment "REG-Player needs a toolchain w/ C++17, OpenGL/GLES"
	depends on !BR2_INSTALL_LIBSTDCPP || \
		!(BR2_PACKAGE_HAS_LIBGLES || BR2_PACKAGE_HAS_LIBGL)
