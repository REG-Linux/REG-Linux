config BR2_PACKAGE_OPENSBI_K3
    bool "opensbi-k3"
    depends on BR2_PACKAGE_SYSTEM_TARGET_K3
    depends on BR2_TARGET_OPENSBI
    help
        Wraps the mainline OpenSBI fw_dynamic.bin into a FIT image
        (fw_dynamic.itb) for SpacemiT K3 platforms where SPL expects
        OpenSBI in FIT format.
