/dts-v1/;

/ {
	description = "Configuration to load OpenSBI before U-Boot";
	#address-cells = <2>;

	images {
		opensbi {
			description = "OpenSBI fw_dynamic Firmware";
			type = "firmware";
			os = "opensbi";
			arch = "riscv";
			compression = "none";
			/* K3 DDR is at 0x1_0000_0000; matches U-Boot SPL
			 * CONFIG_SPL_OPENSBI_LOAD_ADDR=0x100000000 and the vendor
			 * opensbi spacemit/fw_dynamic.its. K1 used <0 0>. */
			load = <0x1 0x0>;
			entry = <0x1 0x0>;
			data = /incbin/("fw_dynamic.bin");
			hash-1 {
				algo = "crc32";
			};
		};
	};
	configurations {
		default = "config_1";

		config_1 {
			description = "opensbi FIT config";
			firmware = "opensbi";
		};
	};
};
