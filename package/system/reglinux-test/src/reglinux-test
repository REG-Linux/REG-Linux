#!/usr/bin/env python3
# reglinux-test: black-box test + fuzz harness for REG-Linux.
# Spawns existing CLIs only (regmsg, regstation, libra_test, /dev/uinput).

import argparse
import os
import sys
from pathlib import Path

LIB_DIR = "/usr/lib/reglinux-test"
SHARE_DIR = "/usr/share/reglinux-test"

# Allow running from source tree for development.
_here = Path(__file__).resolve().parent
if (_here / "lib" / "engine.py").exists():
    LIB_DIR = str(_here)
    SHARE_DIR = str(_here)

sys.path.insert(0, LIB_DIR)

from lib.engine import Engine
from lib.env import build_env
from lib.report import write_reports

DEFAULT_SCENARIO_DIR = f"{SHARE_DIR}/scenarios"
DEFAULT_OUT_DIR = "/userdata/reportTest"


def cmd_env(args):
    env = build_env()
    import json
    print(json.dumps(env, indent=2, default=str))
    return 0


def cmd_list(args):
    sdir = Path(args.scenario_dir)
    for p in sorted(sdir.glob("*.yml")):
        print(p.stem)
    return 0


def cmd_run(args):
    env = build_env()
    if args.force_backend and env["display"]["backend"] != args.force_backend:
        print(f"ERROR: backend is {env['display']['backend']}, "
              f"--force-backend={args.force_backend}", file=sys.stderr)
        return 2

    eng = Engine(env=env, out_root=args.out, time_per_game=args.time,
                 screenshot=args.screenshot, keep_going=args.keep_going,
                 backend_filter=args.backend_filter, case_filter=args.filter,
                 seed=args.seed)

    scenarios = _resolve_scenarios(args)
    if not scenarios:
        print("no scenarios match", file=sys.stderr)
        return 2

    run = eng.run_all(scenarios)
    write_reports(run)
    print(f"\nReport: {run['run_dir']}")
    return 0 if run["summary"]["fail"] == 0 else 1


def _resolve_scenarios(args):
    sdir = Path(args.scenario_dir)
    if args.scenario:
        paths = []
        for name in args.scenario:
            p = sdir / f"{name}.yml" if not name.endswith(".yml") else Path(name)
            if not p.exists():
                print(f"scenario not found: {p}", file=sys.stderr)
                return []
            paths.append(p)
        return paths
    return sorted(sdir.glob("*.yml"))


def cmd_replay(args):
    case_dir = Path(args.case_dir)
    cmd_log = case_dir / "cmd.log"
    if not cmd_log.exists():
        print(f"no cmd.log in {case_dir}", file=sys.stderr)
        return 2
    print(cmd_log.read_text())
    return 0


def cmd_fuzz(args):
    from lib import fuzz
    return fuzz.run(args)


def main(argv):
    p = argparse.ArgumentParser(prog="reglinux-test",
                                description="REG-Linux test + fuzz harness")
    p.add_argument("--scenario-dir", default=DEFAULT_SCENARIO_DIR)
    p.add_argument("--out", default=DEFAULT_OUT_DIR,
                   help="output root (default /userdata/reportTest)")

    sub = p.add_subparsers(dest="cmd")

    pr = sub.add_parser("run", help="run scenarios")
    pr.add_argument("scenario", nargs="*", help="scenario name(s); empty = all")
    _common_run_args(pr)
    pr.set_defaults(func=cmd_run)

    pl = sub.add_parser("list", help="list available scenarios")
    pl.set_defaults(func=cmd_list)

    pe = sub.add_parser("env", help="print detected environment as JSON")
    pe.set_defaults(func=cmd_env)

    prp = sub.add_parser("replay", help="show cmd.log of a case")
    prp.add_argument("case_dir")
    prp.set_defaults(func=cmd_replay)

    pf = sub.add_parser("fuzz", help="fuzzing harness")
    pf.add_argument("target", choices=["rom", "cli", "lifecycle"])
    pf.add_argument("-t", "--time", type=int, default=60,
                    help="duration seconds")
    pf.add_argument("--seed", type=int, default=0)
    pf.add_argument("--filter", default=None)
    pf.add_argument("--backend-filter", default=None)
    pf.add_argument("--force-backend", default=None)
    pf.add_argument("--keep-going", action="store_true")
    pf.add_argument("-s", "--screenshot", action="store_true")
    pf.set_defaults(func=cmd_fuzz)

    # convenience aliases
    for alias in ("frontend", "ipc", "libra"):
        sp = sub.add_parser(alias, help=f"run {alias}-related scenarios")
        _common_run_args(sp)
        sp.set_defaults(func=lambda a, _alias=alias: _alias_dispatch(a, _alias))

    args = p.parse_args(argv)
    if not args.cmd:
        p.print_help()
        return 1
    return args.func(args)


def _alias_dispatch(args, alias):
    args.scenario = {
        "frontend": ["frontend_lifecycle"],
        "ipc": ["ipc_contract", "launcher_smoke"],
        "libra": ["core_matrix"],  # libra path inside scenario via backend flag
    }[alias]
    return cmd_run(args)


def _common_run_args(p):
    p.add_argument("-t", "--time", type=int, default=10,
                   help="seconds the game runs (default 10)")
    p.add_argument("-s", "--screenshot", action="store_true")
    p.add_argument("--filter", default=None,
                   help="case-id glob filter (e.g. 'L3/megadrive/*')")
    p.add_argument("--backend-filter", default=None,
                   help="run only scenarios matching detected backend "
                        "(sway|weston|kms|any)")
    p.add_argument("--force-backend", default=None,
                   help="abort if detected backend != this (CI guard)")
    p.add_argument("--keep-going", action="store_true",
                   help="continue after failures")
    p.add_argument("--seed", type=int, default=0,
                   help="random seed for matrix shuffling + fuzzing")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
