#!/usr/bin/env python

from __future__ import print_function

from os.path import isfile
from collections import OrderedDict
import sys

import json
import os

# The BIOS manifest is data, shared with regmsgd so the two cannot disagree
# about what a system requires. It lives in package/frontend/es-system because
# it is keyed by es_systems.yml's system names. JSON, not YAML: this renderer
# runs on the build host, whose container has no PyYAML.
def _manifestPath():
    # post-build-script.sh sets REGLINUX_BIOS_MANIFEST; the tree-relative and
    # installed paths are fallbacks for running this by hand.
    candidates = []
    if os.environ.get("REGLINUX_BIOS_MANIFEST"):
        candidates.append(os.environ["REGLINUX_BIOS_MANIFEST"])
    external = os.environ.get("BR2_EXTERNAL_REGLINUX_PATH")
    if not external:
        # .../package/system/reglinux-scripts/scripts/system-systems -> tree root
        external = os.path.abspath(os.path.join(
            os.path.dirname(os.path.abspath(__file__)), "..", "..", "..", ".."))
    candidates.append(os.path.join(
        external, "package", "frontend", "es-system", "bios-manifest.json"))
    candidates.append("/usr/share/reglinux/bios-manifest.json")
    for path in candidates:
        if isfile(path):
            return path
    sys.stderr.write("system-systems: no bios-manifest.json found (tried: {})\n"
                     .format(", ".join(candidates)))
    sys.exit(1)

def _loadSystems():
    with open(_manifestPath()) as handle:
        return json.load(handle, object_pairs_hook=OrderedDict)["systems"]

systems = _loadSystems()


def createReadme(systems):
    for system in sorted(systems):
        print("{}:".format(systems[system]["name"]))
        for bios in systems[system]["biosFiles"]:
            # Name the member for a zippedFile entry, else the readme just
            # repeats the same archive path with no md5 against it.
            name = bios["file"]
            if "zippedFile" in bios:
                name = "{} ({})".format(bios["file"], bios["zippedFile"])
            print("{} {}".format(bios["md5"] if bios["md5"] else "-", name))
        print("")

if __name__ == '__main__':
    # Validation moved to regmsgd (`regmsg bios check`), which reads this same
    # manifest. What stays here is the readme rendering, because
    # post-build-script.sh runs it on the BUILD HOST, where no target binary
    # can run and the image does not exist yet.
    if len(sys.argv) == 2 and sys.argv[1] == "--createReadme":
        createReadme(systems)
    else:
        sys.stderr.write(
            "system-systems: only --createReadme remains here; use "
            "`regmsg bios check` for validation\n")
        sys.exit(2)
