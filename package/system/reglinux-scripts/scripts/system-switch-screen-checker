#!/bin/dash
# Sync REG-Linux's preferred output to sway / PipeWire.
#   --init         record baseline output list
#   --force        skip baseline check; wait for regstation; migrate
#   --focus-only   just point sway focus at preferred external output
#   --audio-resync suspend+unsuspend external sinks (recovers q6afe DSP
#                  after screensaver display-off wedges DEVICE_STOP)
#   <none>         diff vs baseline; on add/remove migrate + (un)suspend audio

[ -f /etc/profile.d/04-sway.sh ] && . /etc/profile.d/04-sway.sh
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/0}"
STATUS_FILE=/var/run/system-switch-screen-checker-status

# NB: suspend-sink returns success and does nothing while a stream is linked
# to the sink, so this only bites when the external sink is already idle.
if [ "$1" = "--audio-resync" ]; then
    command -v pactl >/dev/null 2>&1 || exit 0
    for SINK in $(pactl list short sinks 2>/dev/null \
                    | awk '/HiFi__(DisplayPort|HDMI)/ {print $2}'); do
        pactl suspend-sink "$SINK" 1 >/dev/null 2>&1
        sleep 0.3
        pactl suspend-sink "$SINK" 0 >/dev/null 2>&1
    done
    exit 0
fi

NOW=$(regmsg screen listoutputs 2>/dev/null | sort)
[ -z "$NOW" ] && exit 0

# Prefer external connectors (DP*, HDMI-A*) over the internal panel.
TARGET=$(printf '%s\n' "$NOW" | grep -vE '^(DSI|eDP)-' | head -n1)
[ -z "$TARGET" ] && TARGET=$(printf '%s\n' "$NOW" | head -n1)

case "$1" in
    --init)
        printf '%s\n' "$NOW" > "$STATUS_FILE"
        exit 0
        ;;
    --focus-only)
        [ -S "$SWAYSOCK" ] && command -v swaymsg >/dev/null 2>&1 \
            && swaymsg "focus output \"$TARGET\"" >/dev/null 2>&1
        exit 0
        ;;
esac

if [ "$1" != "--force" ]; then
    PREV=$(cat "$STATUS_FILE" 2>/dev/null)
    printf '%s\n' "$NOW" > "$STATUS_FILE"
    [ "$PREV" = "$NOW" ] && exit 0
fi

# Force (un)suspend on external add/remove to avoid stale ALSA state
# (without this, a fast cable cycle silently kills DP audio).
EXT_REMOVED=$(printf '%s\n%s\n%s\n' "$PREV" "$NOW" "$NOW" | sort | uniq -u | grep -E '^(DP|HDMI-A)-' || true)
EXT_ADDED=$(printf '%s\n%s\n%s\n' "$NOW" "$PREV" "$PREV" | sort | uniq -u | grep -E '^(DP|HDMI-A)-' || true)
if [ -n "$EXT_REMOVED$EXT_ADDED" ] && command -v pactl >/dev/null 2>&1; then
    for SINK in $(pactl list short sinks 2>/dev/null \
                    | awk '/HiFi__(DisplayPort|HDMI)/ {print $2}'); do
        [ -n "$EXT_REMOVED" ] && pactl suspend-sink "$SINK" 1 >/dev/null 2>&1
        [ -n "$EXT_ADDED" ]   && pactl suspend-sink "$SINK" 0 >/dev/null 2>&1
    done
fi

[ -S "$SWAYSOCK" ] || exit 0
command -v swaymsg >/dev/null 2>&1 || exit 0
command -v jq      >/dev/null 2>&1 || exit 0

# REG-Station calls --force right after window->init(); the new wl_surface
# can lag sway events by tens of ms, so poll briefly (no jq in hot loop).
if [ "$1" = "--force" ]; then
    _i=0
    while [ "$_i" -lt 30 ]; do
        case "$(swaymsg -t get_tree 2>/dev/null)" in
            *'"app_id": "regstation"'*) break ;;
        esac
        sleep 0.1
        _i=$((_i + 1))
    done
fi

# Batch the move-workspace commands into one swaymsg call.
# Final `workspace LAST` is required: `move workspace to output` keeps
# the destination's previously-visible workspace, so we'd be off-screen.
WSLIST=$(swaymsg -t get_workspaces 2>/dev/null \
            | jq -r '.[] | select((.nodes|length>0) or (.floating_nodes|length>0)) | .name')
[ -z "$WSLIST" ] && exit 0

CMD=""
LAST=""
for WS in $WSLIST; do
    CMD="$CMD; workspace \"$WS\"; move workspace to output \"$TARGET\""
    LAST="$WS"
done
# Trailing `focus output TARGET` is required: on cable replug, sway's
# output-add settling can override a plain `workspace LAST`, leaving
# focus on the previously-focused (now-empty) output and starving the
# emulator of keyboard / Wayland input.
swaymsg "${CMD#; }; workspace \"$LAST\"; focus output \"$TARGET\"" >/dev/null 2>&1
