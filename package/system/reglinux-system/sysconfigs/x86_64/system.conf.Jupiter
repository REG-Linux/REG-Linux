# Steam Deck LCD default values

# default card
# NOTE: pro-audio kept for now. Dropping it needs the OdroidC5 approach
# (per-card UCM2 + WirePlumber prefer-profile rule), validated on real
# hardware first — none of these boards were testable. See board/amlogic/odroidc5.
audio.device=alsa_output.pci-0000_04_00.5-platform-acp5x_mach.0.pro-output-1

# default wayland environment (rotate)
system.rs.environment=wayland

# default suspend on handled boards
system.suspendmode=suspend
