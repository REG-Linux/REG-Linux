comment "rtl8733bu needs a Linux kernel to be built"
	depends on !BR2_LINUX_KERNEL

config BR2_PACKAGE_RTL8733BU
	bool "rtl8733bu"
	depends on BR2_LINUX_KERNEL
	help
	  Linux driver for the USB WiFi half of the Realtek RTL8733BU
	  WiFi/BT combo chip, as found in the Miyoo Flip.

	  https://github.com/Charliechen114514/rtl8733bu-linux-driver
