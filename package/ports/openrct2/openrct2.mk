################################################################################
#
# OpenRCT2 (Roller Coaster Tycoon 2 open source engine)
#
################################################################################

OPENRCT2_VERSION = v0.5.6
OPENRCT2_SITE = $(call github,OpenRCT2,OpenRCT2,$(OPENRCT2_VERSION))
OPENRCT2_LICENSE = GPL-3.0

OPENRCT2_DEPENDENCIES  = sdl2 libcurl libzip speexdsp flac libvorbis
OPENRCT2_DEPENDENCIES += zlib zstd libpng icu openssl freetype fontconfig
OPENRCT2_DEPENDENCIES += json-for-modern-cpp host-openrct2

# Out-of-tree build is enforced in CMake
OPENRCT2_SUPPORTS_IN_SOURCE_BUILD = NO

# No discord, link libopenrct2 into the binary instead of shipping a .so
OPENRCT2_CONF_OPTS += -DBUILD_SHARED_LIBS=OFF
OPENRCT2_CONF_OPTS += -DDISABLE_DISCORD_RPC=ON

# -Werror is hardcoded into CMAKE_CXX_FLAGS by upstream, so -Wno-error only wins
# from the per-build-type flags, which the compiler sees afterwards. Recent
# zlib headers trip -Wold-style-cast. Keep the -O level from CMAKE_CXX_FLAGS.
OPENRCT2_CONF_OPTS += -DCMAKE_CXX_FLAGS_RELEASE="-DNDEBUG -Wno-error"

ifeq ($(BR2_PACKAGE_HAS_OPENGL),y)
OPENRCT2_CONF_OPTS += -DDISABLE_OPENGL=OFF
OPENRCT2_DEPENDENCIES += gl
else
OPENRCT2_CONF_OPTS += -DDISABLE_OPENGL=ON
endif

# Assets, as pinned by the upstream assets.json. CMake normally pulls these off
# the network during the install step; fetch them the buildroot way instead so
# they are cached in $(DL_DIR), hash checked, and usable offline.
OPENRCT2_EXTRA_DOWNLOADS  = https://github.com/OpenRCT2/objects/releases/download/v1.8.0/objects.zip
OPENRCT2_EXTRA_DOWNLOADS += https://github.com/OpenRCT2/title-sequences/releases/download/v0.5.6/title-sequences.zip
OPENRCT2_EXTRA_DOWNLOADS += https://github.com/OpenRCT2/OpenSoundEffects/releases/download/v1.0.6/opensound.zip
OPENRCT2_EXTRA_DOWNLOADS += https://github.com/OpenRCT2/OpenMusic/releases/download/v1.6.1/openmusic.zip

OPENRCT2_CONF_OPTS += -DDOWNLOAD_OBJECTS=OFF
OPENRCT2_CONF_OPTS += -DDOWNLOAD_TITLE_SEQUENCES=OFF
OPENRCT2_CONF_OPTS += -DDOWNLOAD_OPENSFX=OFF
OPENRCT2_CONF_OPTS += -DDOWNLOAD_OPENMUSIC=OFF

# Unpack the assets where the download step would have put them: CMake installs
# data/ wholesale, so they end up in /usr/share/openrct2. opensound.zip and
# openmusic.zip already carry their assetpack/ prefix.
#
# Must run POST_CONFIGURE, not POST_EXTRACT: $(BR2_CMAKE) needs host-cmake,
# which Buildroot only stages into this package's per-package host dir at the
# configure stamp (see _FINAL_DEPENDENCIES vs _FINAL_EXTRACT_DEPENDENCIES in
# pkg-generic.mk) -- it doesn't exist yet during POST_EXTRACT_HOOKS.
define OPENRCT2_EXTRACT_ASSETS
	mkdir -p $(@D)/data/object $(@D)/data/sequence
	$(BR2_CMAKE) -E chdir $(@D)/data/object \
		$(BR2_CMAKE) -E tar xf $(OPENRCT2_DL_DIR)/objects.zip
	$(BR2_CMAKE) -E chdir $(@D)/data/sequence \
		$(BR2_CMAKE) -E tar xf $(OPENRCT2_DL_DIR)/title-sequences.zip
	$(BR2_CMAKE) -E chdir $(@D)/data \
		$(BR2_CMAKE) -E tar xf $(OPENRCT2_DL_DIR)/opensound.zip
	$(BR2_CMAKE) -E chdir $(@D)/data \
		$(BR2_CMAKE) -E tar xf $(OPENRCT2_DL_DIR)/openmusic.zip
endef
OPENRCT2_POST_CONFIGURE_HOOKS += OPENRCT2_EXTRACT_ASSETS

# The graphics files are generated by running the freshly built openrct2-cli,
# which CMake skips when cross-compiling. It installs them unconditionally
# though, so take the ones the host build produced.
define OPENRCT2_GRAPHICS_FROM_HOST
	cp $(addprefix $(HOST_OPENRCT2_BUILDDIR)/,g2.dat fonts.dat palettes.dat tracks.dat) \
		$(OPENRCT2_BUILDDIR)/
endef
OPENRCT2_POST_BUILD_HOOKS += OPENRCT2_GRAPHICS_FROM_HOST

$(eval $(cmake-package))

# The host build exists only to run "openrct2-cli sprite build", so cut it down
# to what that needs: no GUI (which drops SDL2, OpenGL and the audio codecs
# along with it), no network or HTTP (which would want libcurl), no TTF.
HOST_OPENRCT2_DEPENDENCIES = host-libzip host-libpng host-zlib host-zstd \
	host-icu host-json-for-modern-cpp

HOST_OPENRCT2_CONF_OPTS += -DDISABLE_GUI=ON
HOST_OPENRCT2_CONF_OPTS += -DDISABLE_NETWORK=ON
HOST_OPENRCT2_CONF_OPTS += -DDISABLE_HTTP=ON
HOST_OPENRCT2_CONF_OPTS += -DDISABLE_TTF=ON
HOST_OPENRCT2_CONF_OPTS += -DDISABLE_DISCORD_RPC=ON

# Buildroot leaves CMAKE_BUILD_TYPE empty for host packages, so ask for Release
# explicitly, otherwise the -Wno-error above would never be applied
HOST_OPENRCT2_CONF_OPTS += -DCMAKE_BUILD_TYPE=Release
HOST_OPENRCT2_CONF_OPTS += -DCMAKE_CXX_FLAGS_RELEASE="-DNDEBUG -Wno-error"

# "graphics" is only wired to the GUI binary, which we just disabled
define HOST_OPENRCT2_BUILD_GRAPHICS
	$(HOST_MAKE_ENV) $(BR2_CMAKE) --build $(HOST_OPENRCT2_BUILDDIR) --target graphics
endef
HOST_OPENRCT2_POST_BUILD_HOOKS += HOST_OPENRCT2_BUILD_GRAPHICS

# Nothing to install: the target build reads the graphics straight out of the
# host build directory, and upstream's install rules would pull the whole asset
# set off the network into $(HOST_DIR). Must be a non-empty no-op, as an empty
# value would leave pkg-cmake's own ifndef-guarded default in place.
define HOST_OPENRCT2_INSTALL_CMDS
	true
endef

$(eval $(host-cmake-package))
