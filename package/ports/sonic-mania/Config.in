config BR2_PACKAGE_SONIC_MANIA
	bool "sonic-mania"
	select BR2_PACKAGE_LIBGLU   if BR2_PACKAGE_XORG7
	select BR2_PACKAGE_LIBGLEW  if BR2_PACKAGE_XORG7
	select BR2_PACKAGE_LIBGLFW  if BR2_PACKAGE_XORG7
	select BR2_PACKAGE_SDL2
	select BR2_PACKAGE_LIBOGG
	select BR2_PACKAGE_LIBTHEORA
	help
	  A complete decompilation of Sonic Mania (2017).

	  https://github.com/RSDKModding/Sonic-Mania-Decompilation
