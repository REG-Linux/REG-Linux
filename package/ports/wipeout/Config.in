config BR2_PACKAGE_WIPEOUT
	bool "wipeout"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on !BR2_STATIC_LIBS
	select BR2_PACKAGE_SDL2
	help
	  Reimplementation of the PSX Wipeout racing game engine
	  by phoboslab. Supports GL, GLES2, and software rendering.
	  Requires original PSX Wipeout data files.

	  https://github.com/phoboslab/wipeout-rewrite
