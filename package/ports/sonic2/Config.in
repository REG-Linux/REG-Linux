config BR2_PACKAGE_SONIC2
	bool "sonic2"
	select BR2_PACKAGE_SDL2
	select BR2_PACKAGE_SDL2_NET
	select BR2_PACKAGE_SDL2_MIXER
	select BR2_PACKAGE_LIBOGG
	select BR2_PACKAGE_LIBVORBIS
	select BR2_PACKAGE_LIBGLEW    if BR2_PACKAGE_HAS_LIBGL
	select BR2_PACKAGE_LIBGLU     if BR2_PACKAGE_HAS_LIBGL
	select BR2_PACKAGE_LIBGL      if BR2_PACKAGE_HAS_LIBGL
	select BR2_PACKAGE_LIBGLES    if BR2_PACKAGE_HAS_LIBGLES

    help
      Sonic the Hedgehog 2 using the RSDKv4 Decompilation engine.
      Same engine as sonic2013 (Sonic 1). Requires retail game data.

	  https://github.com/RSDKModding/RSDKv4-Decompilation
