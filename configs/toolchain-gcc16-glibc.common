# toolchain definition
BR2_OPTIMIZE_3=y
BR2_ENABLE_LTO=y
BR2_SHARED_STATIC_LIBS=y
BR2_GCC_ENABLE_GRAPHITE=y
BR2_GCC_ENABLE_OPENMP=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_TOOLCHAIN_BUILDROOT_WCHAR=y
BR2_GCC_VERSION_16_X=y
# binutils 2.46.0 — matches the gcc16 era; full coverage of the recent RISC-V standard
# extensions gcc16 emits (zicond/zvkt/zvl256b/zvfh/...). Note: no stock binutils assembles
# SpacemiT's vendor xsmtvdot, so boards avoid it in -march (see reglinux-k1.board).
BR2_BINUTILS_VERSION_2_46_X=y
# required for utf-8
BR2_TOOLCHAIN_GLIBC_GCONV_LIBS_COPY=y
# Allow to build GOLD linker, but do not use as default
BR2_BINUTILS_EXTRA_CONFIG_OPTIONS="--enable-gold --enable-plugins"
# glibc utils
BR2_PACKAGE_GLIBC_UTILS=y
